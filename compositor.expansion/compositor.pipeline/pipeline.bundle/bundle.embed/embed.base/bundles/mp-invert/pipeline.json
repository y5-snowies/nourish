{
  "name": "mp-invert",
  "version": 1,
  "category": "Multipass",
  "modules": [
    "../mp-parallax/lib/parallax.wgsl"
  ],
  "passes": [
    {
      "name": "backdrop",
      "shader": "../mp-parallax/passes/backdrop.wgsl",
      "output": "output"
    },
    {
      "name": "invert",
      "shader": "passes/invert.wgsl",
      "when": "after-content",
      "inputs": {
        "scene": "content"
      },
      "output": "output",
      "requires": [
        "composited_scene"
      ]
    }
  ],
  "decorations": "off",
  "letterbox": "on-resize"
}
