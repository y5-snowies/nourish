[Unit]
Description=X Wayland Satellite (y5, with --popup-fix)
After=graphical-session.target
PartOf=graphical-session.target
# Don't retry forever on a real fault (e.g. Xwayland not installed): five attempts inside
# 60s, then stay failed so `systemctl --user status` shows the actual reason. These live in
# [Unit], not [Service] — systemd ignores them there (systemd-analyze verify catches it).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple

# Wait for the compositor's socket to EXIST, rather than sleeping and hoping.
#
# The race this replaces: y5.service is Type=exec, so systemd considers it "started" the
# moment the binary is exec'd — not when the compositor has finished booting and published
# its socket. graphical-session.target is reached almost immediately after that, so this
# unit (After=/WantedBy= that target) could be spawned while the compositor is still
# initializing. The previous fix was `ExecStartPre=/usr/bin/sleep 20`, which cost 20 seconds
# of no-X on every single login and still only guessed.
#
# WAYLAND_DISPLAY comes from the compositor calling
# `dbus-update-activation-environment --systemd` once it is actually up, so an unset value
# here means "not up yet", which is exactly what we poll for. systemd builds each command's
# environment at spawn time, so ExecStart below sees whatever the wait observed.
#
# 60s of 0.25s polls. Exits non-zero on timeout so the failure is a failure, not a
# silently dead X.
ExecStartPre=/bin/sh -c 'i=0; while [ $i -lt 240 ]; do \
    [ -n "$WAYLAND_DISPLAY" ] && [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && exit 0; \
    i=$((i+1)); sleep 0.25; \
  done; \
  echo "xwayland: no wayland socket after 60s (WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-unset})" >&2; \
  exit 1'

# Flags:
#   --force-scale 1            freeze effective scale at 1x (DPI-unaware X apps keep a
#                              consistent physical size across integer/fractional scale changes).
#                              NOTE: space-separated form only; "--force-scale=1" is rejected.
#   --ignore-fractional-scale  use integer wl_output scale only; skip wp_fractional_scale.
#   --popup-fix                keep borderless/CSD windows that register WM_DELETE_WINDOW as
#                              xdg_toplevels instead of demoting them to xdg_popups (empty surface).
#                              Required for Isaac Sim "move to external window" tear-off panels.
ExecStart=/usr/bin/xwayland-satellite :12 --force-scale 1 --ignore-fractional-scale --popup-fix

# `Restart=never` was here, which is NOT a valid systemd value (the set is no | on-success |
# on-failure | on-abnormal | on-watchdog | on-abort | always). systemd logged a parse error
# and fell back to `no`, so there was no retry at all and any transient failure was permanent
# for the whole session. on-failure with a short delay makes a lost race self-correct.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
