{
  "name": "tb-window-rects-inline",
  "version": 1,
  "passes": [
    {
      "name": "backdrop",
      "shader": "../tb-window-rects/passes/backdrop.wgsl",
      "output": "output",
      "place": "compositor"
    },
    {
      "name": "outline",
      "shader": "../tb-window-rects/passes/outline.wgsl",
      "when": "after-content",
      "inputs": {
        "scene": "content"
      },
      "output": "output",
      "requires": ["window_geometry", "composited_scene"],
      "place": "compositor"
    }
  ],
  "decorations": "off",
  "letterbox": "always"
}
