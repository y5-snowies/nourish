{
  "name": "tb-chain-proof",
  "version": 1,
  "targets": {
    "a": {
      "format": "rgba16f",
      "scale": 1.0
    },
    "b": {
      "format": "rgba16f",
      "scale": 0.5
    },
    "c": {
      "format": "rgba16f",
      "scale": 1.0
    }
  },
  "passes": [
    {
      "name": "s0",
      "shader": "passes/s0.wgsl",
      "output": "a"
    },
    {
      "name": "s1",
      "shader": "passes/s1.wgsl",
      "inputs": {
        "prev": "a"
      },
      "output": "b"
    },
    {
      "name": "s2",
      "shader": "passes/s2.wgsl",
      "inputs": {
        "prev": "b"
      },
      "output": "c"
    },
    {
      "name": "report",
      "shader": "passes/report.wgsl",
      "inputs": {
        "chain": "c"
      },
      "output": "output"
    }
  ],
  "decorations": "off",
  "letterbox": "always"
}
