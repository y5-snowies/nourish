{
  "name": "tb-window-mirror",
  "version": 1,
  "passes": [
    {
      "name": "backdrop",
      "shader": "passes/backdrop.wgsl",
      "output": "output"
    },
    {
      "name": "mirror",
      "shader": "passes/mirror.wgsl",
      "when": "after-content",
      "inputs": {
        "scene": "content"
      },
      "output": "output",
      "requires": ["window_geometry", "window_textures", "composited_scene"]
    }
  ],
  "decorations": "off",
  "letterbox": "always"
}
