{
  "name": "glass-inline",
  "version": 1,
  "passes": [
    {
      "name": "backdrop",
      "shader": "../glass/passes/backdrop.wgsl",
      "output": "output",
      "place": "compositor"
    },
    {
      "name": "glass",
      "shader": "../glass/passes/glass.wgsl",
      "when": "after-content",
