{
  "name": "tb-chain-proof-inline",
  "version": 1,
  "targets": {
    "a": {
      "format": "rgba16f",
      "scale": 1.0
    },
    "b": {
      "format": "rgba16f",
      "scale": 0.5
    },
    "c": {
      "format": "rgba16f",
      "scale": 1.0
    }
  },
  "passes": [
    {
      "name": "s0",
      "shader": "../tb-chain-proof/passes/s0.wgsl",
      "output": "a",
      "place": "compositor"
    },
    {
      "name": "s1",
      "shader": "../tb-chain-proof/passes/s1.wgsl",
      "inputs": {
        "prev": "a"
      },
      "output": "b",
      "place": "compositor"
    },
    {
      "name": "s2",
      "shader": "../tb-chain-proof/passes/s2.wgsl",
      "inputs": {
        "prev": "b"
      },
      "output": "c",
      "place": "compositor"
    },
    {
      "name": "report",
      "shader": "../tb-chain-proof/passes/report.wgsl",
      "inputs": {
        "chain": "c"
      },
      "output": "output",
      "place": "compositor"
    }
  ],
  "decorations": "off",
  "letterbox": "always"
}
