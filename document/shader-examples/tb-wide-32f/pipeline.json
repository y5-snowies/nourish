{
  "name": "tb-wide-32f",
  "version": 1,
  "targets": {
    "hi_a": {
      "format": "rgba32f",
      "scale": 1.0
    },
    "hi_b": {
      "format": "rgba32f",
      "scale": 1.0
    }
  },
  "passes": [
    {
      "name": "seed",
      "shader": "passes/seed.wgsl",
      "output": "hi_a"
    },
    {
      "name": "wide",
      "shader": "passes/wide.wgsl",
      "inputs": {
        "src": "hi_a"
      },
      "output": "hi_b"
    },
    {
      "name": "out",
      "shader": "passes/out.wgsl",
      "inputs": {
        "src": "hi_b"
      },
      "output": "output"
    }
  ],
  "decorations": "off",
  "letterbox": "always"
}
