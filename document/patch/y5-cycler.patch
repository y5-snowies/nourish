index 00000000..f5a5bda2
--- /dev/null
+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.scene/scene.create/create.rs
@@ -0,0 +1,77 @@
+//! Building the switcher's sphere instance in the bevy registry.
+//!
+//! Unlike the picker's full-screen globe this is a SUB-RECT instance:
+//! `create_screen` places it at `rect.loc` at `rect.size`, and the scene's aspect
+//! is that rect's, not the output's. Everything downstream depends on that
+//! agreement — `sphere.pick` works in render-target pixels, so a scene built at
+//! the output aspect would put the ray-cast and the picture in different spaces.
+
+use std::sync::Arc;
+
+use compositor_orchestration_core_state_base::Loop;
+use compositor_orchestration_draw_layer_base::base::Layer;
+use compositor_y5_switcher_sphere_constant::CELL_COUNT;
+use compositor_y5_switcher_system_base::base::scene_registry;
+use compositor_y5_switcher_three_scene::scene::SwitcherScene;
+use smithay::backend::renderer::gles::GlesRenderer;
+use smithay::utils::{Physical, Rectangle};
+
+/// Build the sphere for the current session at `rect`. No-op without a session,
+/// or if one is already built.
+pub fn create(state: &mut Loop, renderer: &mut GlesRenderer, rect: Rectangle<i32, Physical>) {
+    let Some(open) = state.inner.switcher().open.as_ref() else { return };
+    if open.bevy.is_some() || rect.size.w <= 0 || rect.size.h <= 0 {
+        return;
+    }
+    // Both lists are per CELL, while `order`/`cell_of` are per entry — so invert.
+    // A window whose texture could not be allocated is still occupied: its cell
+    // renders as a solid patch rather than a hole.
+    let mut occupied = vec![false; CELL_COUNT];
+    let mut cells: Vec<Option<Arc<wgpu::Texture>>> = vec![None; CELL_COUNT];
+    for (i, cell) in open.cell_of.iter().copied().enumerate() {
+        if cell >= CELL_COUNT {
+            continue;
+        }
+        occupied[cell] = true;
+        if let Some(uuid) = open.order.get(i) {
+            cells[cell] = open.textures.iter().find(|t| t.uuid == *uuid).map(|t| t.wgpu.clone());
+        }
+    }
+    let backdrop = compositor_y5_switcher_texture_backdrop::backdrop::texture(state).map(|t| t.wgpu.clone());
+    let scene = SwitcherScene::new(
+        (rect.size.w.max(1) as u32, rect.size.h.max(1) as u32),
+        cells,
+        backdrop,
+        occupied,
+    );
+
+    let gpu = state.inner.environment.GPU.clone();
+    let handle = {
+        let Some(registry) = scene_registry(&mut state.inner.worlds) else {
+            error!("switcher: bevy registry missing — startup prewarm failed");
+            return;
+        };
+        match registry.create_screen(
+            &gpu,
+            scene,
+            renderer,
+            rect.loc,
+            rect.size,
+            Layer::SWITCHER_SCENE.bits(),
+        ) {
+            Ok(handle) => handle,
+            Err(e) => {
+                error!("switcher: create_screen failed: {e:?}");
+                return;
+            }
+        }
+    };
+    if let Some(open) = state.inner.switcher_mut().open.as_mut() {
+        open.bevy = Some(handle);
+    }
+    // Outline the opening cell straight away, so the first frame already shows
+    // where the selection is rather than popping it in on the second.
+    compositor_y5_switcher_scene_command::command::push_selected(state);
+    compositor_y5_switcher_scene_command::command::push_transform(state);
+    info!("switcher: sphere scene created at {}x{}", rect.size.w, rect.size.h);
+}
