+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.sphere/sphere.pick/pick.rs
@@ -0,0 +1,61 @@
+//! Click picking: which cell the pointer is over. Casts a ray from the camera
+//! through the pointer, intersects the sphere, un-rotates the hit by the
+//! sphere's current rotation, and maps it to a cell. Returns None if the ray
+//! misses the sphere (the pointer is outside the silhouette).
+//!
+//! `sphere.navigate` is the sibling that answers the same question for a key.
+//!
+//! PORTED from `y5.picker/picker.pick/pick.base/base.rs`.
+
+use bevy::math::{Quat, Vec3};
+use compositor_y5_switcher_sphere_constant::{camera_distance, CAMERA_FOV_RAD, SPHERE_RADIUS};
+use compositor_y5_switcher_sphere_layout::cell_at_direction;
+use compositor_y5_switcher_sphere_orient::orient::Orient;
+
+/// The cell under the pointer, or `None` when the ray misses the sphere (the
+/// pointer is outside the silhouette).
+///
+/// `pointer` and `target` are in RENDER-TARGET pixels, not output pixels — the
+/// switcher's globe is a sub-rect instance, so the caller passes the rect-local
+/// pointer and the rect's own size. A pointer outside the rect then yields NDC
+/// beyond ±1, the ray misses, and `None` doubles as "not on the globe", which is
+/// exactly what the click router wants.
+///
+/// `zoom` MOVES the camera (`camera_distance`), so it changes both the
+/// silhouette's screen size and where on the sphere a given pixel lands. Pass
+/// the live zoom, never a constant.
+pub fn pick_cell(
+    pointer: (f64, f64),
+    target: (f64, f64),
+    orient: Orient,
+    zoom: f32,
+) -> Option<usize> {
+    let (w, h) = target;
+    if w <= 0.0 || h <= 0.0 {
+        return None;
+    }
+    // Normalized device coords (y up), camera-space ray (camera looks down -Z).
+    let ndc_x = (pointer.0 / w * 2.0 - 1.0) as f32;
+    let ndc_y = (1.0 - pointer.1 / h * 2.0) as f32;
+    let aspect = (w / h) as f32;
+    let tan = (CAMERA_FOV_RAD * 0.5).tan();
+    let dir = Vec3::new(ndc_x * tan * aspect, ndc_y * tan, -1.0).normalize();
+    let origin = Vec3::new(0.0, 0.0, camera_distance(zoom));
+
+    // Ray vs sphere (center origin, radius SPHERE_RADIUS); nearest hit.
+    let b = origin.dot(dir);
+    let c = origin.length_squared() - SPHERE_RADIUS * SPHERE_RADIUS;
+    let disc = b * b - c;
+    if disc < 0.0 {
+        return None;
+    }
+    let t = -b - disc.sqrt();
+    if t < 0.0 {
+        return None;
+    }
+    let hit = origin + dir * t;
+
+    // Un-rotate into the sphere's local frame, then map to a cell.
+    let local = Quat::from_array(orient.quat()).inverse() * hit;
+    Some(cell_at_direction(local.normalize()))
+}
diff --git a/compositor.expansion/compositor.y5/y5.switcher/switcher.stack/stack.center/center.rs b/compositor.expansion/compositor.y5/y5.switcher/switcher.stack/stack.center/center.rs
new file mode 100644
index 00000000..87634065
--- /dev/null
+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.stack/stack.center/center.rs
@@ -0,0 +1,59 @@
+//! Opening selection when nothing holds keyboard focus: the first window that is
+//! not fully occluded, nearest the screen centre.
+//!
+//! Walks the draw order front-to-back depositing each window's projected rect as
+//! an occluder, exactly as the canvas draw pass does, so "fully occluded" here
+//! means the same thing it means on screen. The deposit is unconditional, which
+//! over-culls a translucent window sitting in front of another — acceptable for
+//! an opening heuristic, and it errs toward picking something you can actually
+//! see.
+
+use compositor_orchestration_core_state_base::state::CoordinateTrait;
+use compositor_orchestration_core_state_base::Loop;
+use compositor_y5_camera_transform_translate::transform::Transform;
+use compositor_y5_window_draw_occlude::occlude::Occluders;
+use compositor_y5_window_interface_record::window::LoopWindow;
+use smithay::utils::{Physical, Rectangle};
+use uuid::Uuid;
+
+/// A window's storage rect projected into output-physical space.
+fn projected(state: &Loop, window: &smithay::desktop::Window) -> Option<Rectangle<i32, Physical>> {
+    let rect = state.inner.space_state().state.element_geometry(window)?.to_f64();
+    let transform: Transform = (rect, state.size_ctx_all()).into();
+    Some(transform.into())
+}
+
+/// Squared distance from a rect's centre to the centre of `size`.
+fn distance_sq(rect: Rectangle<i32, Physical>, size: (f64, f64)) -> f64 {
+    let cx = rect.loc.x as f64 + rect.size.w as f64 * 0.5 - size.0 * 0.5;
+    let cy = rect.loc.y as f64 + rect.size.h as f64 * 0.5 - size.1 * 0.5;
+    cx * cx + cy * cy
+}
+
+/// The visible window nearest the screen centre, or `None` when every window is
+/// hidden or the world is empty.
+pub fn fallback(state: &Loop, size: (f64, f64)) -> Option<Uuid> {
+    let mut occluders = Occluders::new();
+    let mut best: Option<(Uuid, f64)> = None;
+    for uuid in state.inner.drawable_order() {
+        let Some(window) = state
+            .inner
+            .space_state()
+            .state
+            .elements()
+            .find(|w| w.uuid() == Some(uuid))
+            .cloned()
+        else {
+            continue;
+        };
+        let Some(rect) = projected(state, &window) else { continue };
+        if !occluders.hidden(rect) {
+            let d = distance_sq(rect, size);
+            if best.map(|(_, bd)| d < bd).unwrap_or(true) {
+                best = Some((uuid, d));
+            }
+        }
+        occluders.push(rect);
+    }
+    best.map(|(uuid, _)| uuid)
+}
