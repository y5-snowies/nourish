diff --git a/compositor.expansion/compositor.y5/y5.switcher/switcher.input/input.keyboard/keyboard.rs b/compositor.expansion/compositor.y5/y5.switcher/switcher.input/input.keyboard/keyboard.rs
new file mode 100644
index 00000000..ad54e092
--- /dev/null
+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.input/input.keyboard/keyboard.rs
@@ -0,0 +1,93 @@
+//! Switcher keyboard handling. The canvas router calls `handle` before the
+//! overview's; returning true INTERCEPTs. While open the switcher consumes every
+//! key — nothing reaches the canvas tools, the focused window, or iced.
+//!
+//! This is hooked at the canvas seam rather than the global shortcut table
+//! because that table early-returns on release, and the switcher needs the ALT-UP
+//! edge for its quick swap.
+//!
+//! ## Why TAB is matched by keysym and not only by `Key`
+//!
+//! Under SHIFT, xkb produces `ISO_Left_Tab`, not `Tab`, and `Key::from_keysym`
+//! has no arm for it — so `Key` alone is `None` and ALT+SHIFT+TAB would never
+//! fire. It is matched here rather than fixed in `Key` on purpose: the overview
+//! binds `Super + Key::Tab` without checking shift, so teaching `Key` about
+//! `ISO_Left_Tab` would make Super+Shift+Tab start toggling the overview.
+
+use compositor_orchestration_core_state_base::Loop;
+use compositor_support_library_input_keyboard_base::keyboard::key::Key;
+use compositor_y5_switcher_input_bind::bind;
+use compositor_y5_switcher_interface_base::base;
+use compositor_y5_switcher_interface_commit::commit;
+use compositor_y5_switcher_interface_cycle::cycle;
+use compositor_y5_switcher_interface_mode::mode;
+use smithay::backend::input::KeyState;
+use smithay::input::keyboard::{keysyms, Keysym, ModifiersState};
+
+pub fn handle(
+    key: Option<Key>,
+    keysym: Keysym,
+    key_state: KeyState,
+    modifiers: &ModifiersState,
+    state: &mut Loop,
+) -> bool {
+    let press = key_state == KeyState::Pressed;
+    let tabbed = key == Some(Key::Tab) || keysym.raw() == keysyms::KEY_ISO_Left_Tab;
+    // Normalized so the reverse binding can match: see `input.bind::matches`.
+    let key_norm = if tabbed { Some(Key::Tab) } else { key };
+
+    // ALT+TAB / ALT+SHIFT+TAB: open on the first press, step on every one after.
+    // Resolved through the keybinding overrides, so both are rebindable.
+    if press {
+        let overrides = &state.inner.keybinding;
+        let forward = bind::matches(overrides, bind::NEXT, modifiers, key_norm);
+        let backward = bind::matches(overrides, bind::PREV, modifiers, key_norm);
+        if forward || backward {
+            if base::is_open(state) {
+                // `step` also counts the advance against the quick-swap gesture.
+                cycle::step(state, if backward { -1 } else { 1 });
+            } else {
+                base::open(state);
+            }
+            return base::is_open(state);
+        }
+    }
+    if !base::is_open(state) {
+        return false;
+    }
+
+    // ALT released. xkb updates before this filter runs, so `modifiers.alt` is
+    // already false here and the key itself is what identifies the edge.
+    if !press && key == Some(Key::Alt) {
+        let armed = state.inner.switcher().open.as_ref().and_then(|o| o.quick);
+        match armed {
+            // Quick swap: the gesture is intact and the selection moved during
+            // it, so letting go means "go there".
+            Some(n) if n > 0 => commit::commit(state),
+            // Either the hold only OPENED the switcher, or the gesture had
+            // already been broken. Both leave the sphere up — and DISARM, so a
+            // later ALT release cannot commit something the user never asked
+            // for. Re-arming here is what made a second hold commit by itself.
+            _ => cycle::disarm(state),
+        }
+        return true;
+    }
+
+    if press {
+        match key {
+            // Bare TAB swaps the cycle order and the list; the globe stays put.
+            _ if tabbed && !modifiers.alt => mode::toggle(state),
+            // Arrows steer by hand, so they END the quick-swap gesture: after
+            // one, releasing ALT must not commit whatever happens to be centred.
+            Some(Key::Left) => cycle::select_direction(state, -1, 0),
+            Some(Key::Right) => cycle::select_direction(state, 1, 0),
+            Some(Key::Up) => cycle::select_direction(state, 0, 1),
+            Some(Key::Down) => cycle::select_direction(state, 0, -1),
+            Some(Key::Escape) => base::close(state),
+            Some(Key::Return) | Some(Key::KpEnter) => commit::commit(state),
+            _ => {}
+        }
+    }
+    // While open the switcher owns the keyboard, on both edges.
+    true
+}
