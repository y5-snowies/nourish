+//! Pushing the compositor's authoritative sphere state into the bevy scene.
+//!
+//! The compositor owns orientation, zoom and selection; the scene only mirrors
+//! them. That direction is deliberate — it is what keeps the click ray-cast
+//! agreeing with what is actually drawn, since both read the same numbers.
+
+use compositor_orchestration_core_state_base::Loop;
+use compositor_y5_switcher_system_base::base::scene_registry;
+use compositor_y5_switcher_three_scene::scene::SwitcherCommand;
+
+/// Dispatch a command to the switcher's bevy instance. No-op if absent.
+pub fn dispatch(state: &mut Loop, command: SwitcherCommand) {
+    let Some(handle) = state.inner.switcher().open.as_ref().and_then(|o| o.bevy) else {
+        return;
+    };
+    if let Some(reg) = scene_registry(&mut state.inner.worlds) {
+        let _ = reg.dispatch_command(handle, command);
+    }
+}
+
+/// Push the current orientation + zoom to the scene.
+pub fn push_transform(state: &mut Loop) {
+    let t = state.inner.switcher().open.as_ref().map(|o| (o.orientation.quat(), o.zoom));
+    if let Some((orientation, zoom)) = t {
+        dispatch(state, SwitcherCommand::SetTransform { orientation, zoom });
+    }
+}
+
+/// Push the selected cell to the scene (drives the outline).
+pub fn push_selected(state: &mut Loop) {
+    let cell = state.inner.switcher().open.as_ref().and_then(|o| o.selected);
+    dispatch(state, SwitcherCommand::SetSelected(cell));
+}
