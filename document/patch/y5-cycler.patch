+//! The positional CYCLE ORDER: windows left to right across the desktop, so
+//! ALT+TAB walks the strip a column at a time and the horizontal list reads in
+//! the same direction. Camera-independent, like the placement it pairs with.
+//!
+//! Only the order. Placement is `layout.place`'s job and is fixed for the
+//! session — a mode change reorders the cycle, it never moves a window.
+
+use compositor_orchestration_core_state_base::Loop;
+use compositor_y5_switcher_layout_project::project::offsets;
+use uuid::Uuid;
+
+/// The camera-centred CYCLE ORDER for `base`: windows left to right as they
+/// appear on screen. Windows with no geometry keep their MRU position at the
+/// tail — they cannot be ordered spatially, but dropping them would make TAB
+/// lose windows.
+///
+/// Placement is deliberately NOT its business any more. The sphere's arrangement
+/// is fixed for a session, so a mode change may reorder the cycle but must never
+/// move a window to a different cell.
+pub fn order(state: &Loop, base: &[Uuid]) -> Vec<Uuid> {
+    let mut placed = offsets(state, base);
+    placed.sort_by(|a, b| a.dx.total_cmp(&b.dx).then(a.dy.total_cmp(&b.dy)));
+    let mut out: Vec<Uuid> = placed.iter().map(|o| o.uuid).collect();
+    let tail: Vec<Uuid> = base.iter().copied().filter(|u| !out.contains(u)).collect();
+    out.extend(tail);
+    out
+}
+
