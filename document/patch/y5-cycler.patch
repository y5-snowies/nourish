diff --git a/compositor.expansion/compositor.y5/y5.switcher/switcher.layout/layout.project/project.rs b/compositor.expansion/compositor.y5/y5.switcher/switcher.layout/layout.project/project.rs
new file mode 100644
index 00000000..bbf2d917
--- /dev/null
+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.layout/layout.project/project.rs
@@ -0,0 +1,61 @@
+//! Where each window sits relative to the OTHER windows — the input the sphere's
+//! arrangement is built from.
+//!
+//! Measured in world coordinates, from the centre of the bounding box the windows
+//! themselves occupy. Deliberately NOT from the screen centre: that would make the
+//! arrangement a function of the camera, so panning, zooming, or committing (which
+//! travels the camera) would deal the same windows onto different cells every time
+//! the switcher opened. The globe would then disagree with itself across a jump,
+//! which is worse than useless — the whole point of placing by position is that a
+//! window is where you last saw it.
+//!
+//! Anchored to the windows rather than to the world origin for the same reason in
+//! reverse: a desktop laid out far from the origin would otherwise pile into one
+//! corner of the sphere instead of spreading across it.
+
+use compositor_orchestration_core_state_base::Loop;
+use compositor_y5_switcher_stack_order::order::window_of;
+use uuid::Uuid;
+
+/// One window's offset from the desktop's centre, in world-logical units. `dy`
+/// grows DOWNWARD, as storage coordinates do — the consumer negates it when
+/// building a direction, since the sphere's up axis is +Y.
+pub struct Offset {
+    pub uuid: Uuid,
+    pub dx: f64,
+    pub dy: f64,
+}
+
+impl Offset {
+    /// Distance from the centre. The tie-break when two windows want the same
+    /// cell: the more central one has the better claim to it.
+    pub fn radius(&self) -> f64 {
+        self.dx.hypot(self.dy)
+    }
+}
+
+/// Project every window in `order` to its offset. A window with no geometry is
+/// dropped — it has no position to lay out by, and the caller gives such entries
+/// a leftover cell rather than losing them.
+pub fn offsets(state: &Loop, order: &[Uuid]) -> Vec<Offset> {
+    let mut bounds: Option<(f64, f64, f64, f64)> = None;
+    let placed: Vec<(Uuid, f64, f64)> = order
+        .iter()
+        .filter_map(|uuid| {
+            let window = window_of(state, *uuid)?;
+            let geom = state.inner.space_state().state.element_geometry(&window)?.to_f64();
+            let (cx, cy) = (
+                geom.loc.x + geom.size.w * 0.5,
+                geom.loc.y + geom.size.h * 0.5,
+            );
+            bounds = Some(match bounds {
+                None => (cx, cy, cx, cy),
+                Some((x0, y0, x1, y1)) => (x0.min(cx), y0.min(cy), x1.max(cx), y1.max(cy)),
+            });
+            Some((*uuid, cx, cy))
+        })
+        .collect();
+    let Some((x0, y0, x1, y1)) = bounds else { return Vec::new() };
+    let (ax, ay) = ((x0 + x1) * 0.5, (y0 + y1) * 0.5);
+    placed.into_iter().map(|(uuid, cx, cy)| Offset { uuid, dx: cx - ax, dy: cy - ay }).collect()
+}
