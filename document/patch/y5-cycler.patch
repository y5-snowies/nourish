+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.draw/draw.rows/rows.rs
@@ -0,0 +1,68 @@
+//! Which entries the stack list shows, and what each one says.
+//!
+//! Windowed on `order` AROUND the selection — `LIST_REACH` either side — so the
+//! previous window is as visible as the next. Deliberately does not wrap: near an
+//! end of a short order the overhanging slots are dropped, because a list that
+//! showed the same window twice would misrepresent how far the cycle goes.
+//!
+//! Titles are read fresh every frame (cheap); icons come from the session cache,
+//! since resolving one stats its way through every icon-theme directory and this
+//! runs on every keypress. An unresolved icon is retried rather than cached, so a
+//! late introspection sample can still fill it in.
+
+use compositor_monitor_overview_ui_list::ListRow;
+use compositor_orchestration_core_state_base::Loop;
+use compositor_y5_switcher_layout_constant::{LIST_ALPHA, LIST_REACH, LIST_ROWS};
+use compositor_y5_switcher_state_base::base::SwitcherOpen;
+
+/// The visible slice of `order` around the selection, as (order index, alpha).
+fn window_of_order(open: &SwitcherOpen) -> Vec<(usize, f32)> {
+    (0..LIST_ROWS)
+        .filter_map(|slot| {
+            let offset = slot as isize - LIST_REACH as isize;
+            let index = open.index as isize + offset;
+            // No wrap: an overhanging slot is dropped, never filled with a repeat.
+            (index >= 0 && (index as usize) < open.order.len())
+                .then(|| (index as usize, LIST_ALPHA[slot]))
+        })
+        .collect()
+}
+
+/// Build the visible rows, resolving titles fresh and icons from the cache.
+pub fn build(state: &mut Loop) -> Option<Vec<(uuid::Uuid, ListRow)>> {
+    let slice = {
+        let open = state.inner.switcher().open.as_ref()?;
+        window_of_order(open)
+            .into_iter()
+            .filter_map(|(i, a)| open.order.get(i).map(|u| (*u, a, i == open.index)))
+            .collect::<Vec<_>>()
+    };
+    let mut rows = Vec::with_capacity(slice.len());
+    for (uuid, alpha, selected) in slice {
+        let Some(window) = compositor_y5_overview_draw_label::label::window_of(state, uuid) else {
+            continue;
+        };
+        let title = compositor_y5_overview_draw_label::label::title_of(&window);
+        let cached = state
+            .inner
+            .switcher()
+            .open
+            .as_ref()
+            .and_then(|o| o.list.icons.get(&uuid).cloned());
+        let icon = match cached {
+            Some(icon) => Some(icon),
+            None => {
+                let (resolved, _) = compositor_y5_overview_draw_icon::icon::resolve(state, &window, uuid);
+                if let Some(icon) = resolved.clone()
+                    && let Some(open) = state.inner.switcher_mut().open.as_mut()
+                {
+                    open.list.icons.insert(uuid, icon);
+                }
+                resolved
+            }
+        };
+        rows.push((uuid, ListRow { title, icon, alpha, selected }));
+    }
+    Some(rows)
+}
+
diff --git a/compositor.expansion/compositor.y5/y5.switcher/switcher.input/input.bind/bind.rs b/compositor.expansion/compositor.y5/y5.switcher/switcher.input/input.bind/bind.rs
new file mode 100644
index 00000000..fb692699
--- /dev/null
+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.input/input.bind/bind.rs
@@ -0,0 +1,72 @@
+//! The switcher's two rebindable shortcuts, and the Keys-tab rows for them.
+//!
+//! Registry-backed rather than hardcoded, unlike the overview's Super+Tab. The
+//! switcher's handler still has to live at the canvas seam — the global shortcut
+//! table drops release edges, and the quick swap needs the ALT-UP one — but it
+//! can resolve its combos from the same `keybinding.json` overrides everything
+//! else uses, so these appear in the settings Keys tab and can be rebound.
+//!
+//! Two entries rather than one because `KeyCombo::matches` compares modifiers
+//! EXACTLY: `Alt+Tab` does not match while Shift is also held, so the reverse
+//! direction has to be its own binding.
+
+use compositor_model_environment_keybinding_base::base::{KeyBindings, KeyRow};
+use compositor_support_library_input_keyboard_base::keyboard::combo::KeyCombo;
+use compositor_support_library_input_keyboard_format::format;
+use compositor_support_library_input_keyboard_base::keyboard::key::Key;
+use compositor_support_library_input_keyboard_base::shortcut;
+
+pub const NEXT: &str = "switcher_next";
+pub const PREV: &str = "switcher_prev";
+
+fn defaults() -> [(&'static str, &'static str, KeyCombo); 2] {
+    [
+        (NEXT, "Window switcher", shortcut!(Alt + Tab)),
+        (PREV, "Window switcher (back)", shortcut!(Alt + Shift + Tab)),
+    ]
+}
+
+/// The combo actually in force for `id` — the override when set, else the
+/// default. `None` means the user disabled it (an empty override).
+pub fn combo(overrides: &KeyBindings, id: &str) -> Option<KeyCombo> {
+    let (_, _, default) = defaults().into_iter().find(|(bid, _, _)| *bid == id)?;
+    match overrides.combo_for(id) {
+        Some("") => None,
+        Some(s) => Some(format::parse_combo(s).unwrap_or(default)),
+        None => Some(default),
+    }
+}
+
+/// Keys-tab rows for both directions.
+pub fn registry(overrides: &KeyBindings) -> Vec<KeyRow> {
+    defaults()
+        .into_iter()
+        .map(|(id, label, default)| {
+            let default = format::combo_string(&default);
+            let combo =
+                overrides.combo_for(id).map(str::to_string).unwrap_or_else(|| default.clone());
+            KeyRow {
+                id: id.to_string(),
+                label: label.to_string(),
+                default,
+                combo,
+                editable: true,
+            }
+        })
+        .collect()
+}
+
+/// Whether a key event matches `id`'s combo.
+///
+/// `key` must already be NORMALIZED: under Shift, xkb reports `ISO_Left_Tab`
+/// rather than `Tab` and `Key::from_keysym` has no arm for it, so the caller
+/// maps it back before asking. Without that, the reverse binding could never
+/// match its own default.
+pub fn matches(
+    overrides: &KeyBindings,
+    id: &str,
+    modifiers: &smithay::input::keyboard::ModifiersState,
+    key: Option<Key>,
+) -> bool {
+    combo(overrides, id).is_some_and(|c| c.matches(modifiers, key))
+}
