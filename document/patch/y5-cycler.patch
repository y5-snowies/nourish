index 00000000..4b546b57
--- /dev/null
+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.layout/layout.place/place.rs
@@ -0,0 +1,100 @@
+//! Where each window sits on the sphere: the cell lying in its own direction
+//! across the desktop.
+//!
+//! THE arrangement — there is only one, decided when the switcher opens and never
+//! recomputed. TAB changes the cycle order and the list, never this.
+//!
+//! Positional rather than stack-ordered because the sphere mirrors the desktop —
+//! a window left of the others belongs on a cell to the left, so the eye finds it
+//! without reading a label. A function of the WINDOWS alone (see `layout.project`)
+//! and never of the camera, so the same desktop always deals onto the same cells
+//! however you have panned or zoomed, and a commit that travels the camera cannot
+//! shuffle the globe behind your back.
+//!
+//! Built in the sphere's IDENTITY frame, so it depends only on where the windows
+//! are and not on how the globe happens to be turned.
+
+use bevy::math::Vec3;
+use compositor_orchestration_core_state_base::Loop;
+use compositor_y5_switcher_layout_project::project::{offsets, Offset};
+use compositor_y5_switcher_sphere_constant::CELL_COUNT;
+use compositor_y5_switcher_sphere_layout::cell_at_direction;
+use compositor_y5_switcher_sphere_navigate::navigate::neighbor;
+use compositor_y5_switcher_sphere_orient::orient;
+use std::collections::HashMap;
+use uuid::Uuid;
+
+/// How far off-axis the outermost window is placed. At a view plane of z = 1 a
+/// span of 1.0 is 45 degrees, which spreads a desktop across the front face and
+/// its neighbours — dense enough to read, wide enough to separate.
+const SPAN: f32 = 1.0;
+
+/// The cell an offset points at, normalized against the widest offset so the
+/// layout uses the same amount of sphere whatever the desktop's spread.
+fn wanted_cell(offset: &Offset, radius: f64) -> usize {
+    let s = (SPAN as f64 / radius.max(1.0)) as f32;
+    // Negate dy: storage y grows downward, the sphere's v axis grows up.
+    let dir = Vec3::new(offset.dx as f32 * s, -(offset.dy as f32) * s, 1.0).normalize();
+    cell_at_direction(dir)
+}
+
+/// The nearest free cell to `wanted`, walking outward through screen-direction
+/// neighbours. Reuses the arrow keys' own stepper so the neighbourhood the spiral
+/// explores is the one the user would navigate — anything else and "the cell to
+/// the right" would mean two different things in the same sphere.
+fn free_cell(wanted: usize, taken: &[bool]) -> usize {
+    if !taken[wanted] {
+        return wanted;
+    }
+    let mut seen = vec![false; CELL_COUNT];
+    let mut queue = std::collections::VecDeque::from([wanted]);
+    seen[wanted] = true;
+    while let Some(cell) = queue.pop_front() {
+        if !taken[cell] {
+            return cell;
+        }
+        let facing = orient::face(cell, 0.0);
+        for (du, dv) in [(1, 0), (-1, 0), (0, 1), (0, -1)] {
+            let next = neighbor(cell, du, dv, facing);
+            if !seen[next] {
+                seen[next] = true;
+                queue.push_back(next);
+            }
+        }
+    }
+    wanted
+}
+
+/// The cell for each entry of `order`, index-parallel to it.
+///
+/// Deliberately does NOT reorder: placement and cycle order are separate axes, and
+/// this one is fixed for the session. Cells are claimed most-central FIRST, so the
+/// window nearest the middle of the desktop gets the cell it actually points at
+/// and the rest spiral around it — claiming in list order would let an outlying
+/// window take the middle and push the central one aside.
+pub fn cells(state: &Loop, order: &[Uuid]) -> Vec<usize> {
+    let placed = offsets(state, order);
+    let radius = placed.iter().map(|o| o.radius()).fold(1.0_f64, f64::max);
+    let mut claim: Vec<usize> = (0..placed.len()).collect();
+    claim.sort_by(|a, b| placed[*a].radius().total_cmp(&placed[*b].radius()));
+
+    let mut taken = vec![false; CELL_COUNT];
+    let mut cell_for: HashMap<Uuid, usize> = HashMap::new();
+    for i in claim {
+        let cell = free_cell(wanted_cell(&placed[i], radius), &taken);
+        taken[cell] = true;
+        cell_for.insert(placed[i].uuid, cell);
+    }
+    // A window with no geometry cannot be placed by direction; it still needs a
+    // cell, or it would vanish from a switcher that is supposed to hold it.
+    order
+        .iter()
+        .map(|uuid| {
+            *cell_for.entry(*uuid).or_insert_with(|| {
+                let cell = free_cell(0, &taken);
+                taken[cell] = true;
+                cell
+            })
+        })
+        .collect()
+}
