+//! Bookkeeping for the switcher's stack-list surface.
+//!
+//! Two things worth their own state. First, what the list was last TOLD, so a
+//! frame that would send identical content sends nothing — this re-renders on
+//! every keypress and iced re-lays the whole view per message. Second, a cache of
+//! RESOLVED icons: an icon-theme lookup stats its way through every size and
+//! context directory, and the list resolves up to five at once, every frame.
+//!
+//! Only resolved icons are cached. An unresolved one is retried, which is what
+//! lets a late introspection sample fill an icon in while the list is still up,
+//! and costs nothing for a window that simply has no icon to find.
+
+use compositor_monitor_compositor_iced_base::HandleId;
+use compositor_monitor_overview_ui_hover::CardIcon;
+use std::collections::HashMap;
+use uuid::Uuid;
+
+/// What the list currently displays: one entry per visible row. Compared whole,
+/// so a title changing under a stationary selection still pushes an update.
+pub type ListKey = Vec<(Uuid, String, bool)>;
+
+#[derive(Default)]
+pub struct ListSurface {
+    /// The iced surface, created on demand and destroyed with the session.
+    pub id: Option<HandleId>,
+    /// The last content actually accepted by the surface — `None` while blank.
+    pub shown: Option<ListKey>,
+    /// Resolved icons by window. Cleared with the session.
+    pub icons: HashMap<Uuid, CardIcon>,
+}
