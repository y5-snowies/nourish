+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.draw/draw.list/list.rs
@@ -0,0 +1,96 @@
+//! The switcher's stack-list surface: its placement, lifecycle, and the de-dup
+//! that keeps a per-keypress redraw from re-laying an unchanged view.
+//!
+//! Its axis follows the mode, because the list should read the way the sphere is
+//! arranged: a vertical list for the MRU stack, a horizontal strip of columns for
+//! the camera-centred layout, whose own order is left-to-right on screen.
+//! Which entries it shows is `draw.rows`.
+
+use compositor_monitor_compositor_iced_base::{HandleId, IcedHandle};
+use compositor_monitor_overview_ui_list::{WindowList, WindowListMessage};
+use compositor_orchestration_core_state_base::Loop;
+use compositor_orchestration_draw_layer_base::base::Layer;
+use compositor_y5_switcher_draw_rows::rows::build;
+use compositor_y5_switcher_layout_constant::{LIST_GAP, LIST_ROW_H, LIST_ROWS, LIST_STRIP_W, LIST_W};
+use compositor_y5_switcher_state_base::base::{Mode, SwitcherOpen};
+use compositor_y5_switcher_state_surface::surface::ListKey;
+use smithay::backend::renderer::gles::GlesRenderer;
+use smithay::utils::{Physical, Point, Size};
+
+/// Where the list sits: under the globe's rect, held on screen.
+fn placement(open: &SwitcherOpen, size: Size<i32, Physical>) -> (Point<i32, Physical>, Size<i32, Physical>) {
+    let horizontal = open.mode == Mode::Spatial;
+    let (w, h) = if horizontal {
+        (LIST_STRIP_W.min(size.w), LIST_ROW_H + 8)
+    } else {
+        (LIST_W.min(size.w), LIST_ROW_H * LIST_ROWS as i32)
+    };
+    let x = (open.rect.loc.x + (open.rect.size.w - w) / 2).clamp(0, (size.w - w).max(0));
+    let y = (open.rect.loc.y + open.rect.size.h + LIST_GAP).clamp(0, (size.h - h).max(0));
+    (Point::from((x, y)), Size::from((w, h)))
+}
+
+pub fn per_frame(state: &mut Loop, renderer: &mut GlesRenderer, size: Size<i32, Physical>) {
+    let Some(rows) = build(state) else {
+        teardown(state);
+        return;
+    };
+    let Some(open) = state.inner.switcher().open.as_ref() else { return };
+    let (loc, extent) = placement(open, size);
+    let (horizontal, existing) = (open.mode == Mode::Spatial, open.list.id);
+    let Some(id) = existing.or_else(|| create(state, renderer, extent)) else { return };
+    if let Some(reg) = state.inner.surface_mut().registry.as_mut() {
+        reg.set_location_by_id(id, loc);
+    }
+    let key: ListKey = rows.iter().map(|r| (r.0, r.1.title.clone(), r.1.selected)).collect();
+    if state.inner.switcher().open.as_ref().and_then(|o| o.list.shown.clone()) == Some(key.clone()) {
+        return;
+    }
+    let sent = state.inner.surface_mut().registry.as_mut().is_some_and(|reg| {
+        reg.dispatch_message(
+            IcedHandle::<WindowList>::from_id(id),
+            WindowListMessage::Set { rows: rows.iter().map(|r| r.1.clone()).collect(), horizontal },
+        )
+        .is_ok()
+    });
+    // Only remember what the surface actually accepted: a dropped message must
+    // not leave this claiming content the list never received.
+    if sent && let Some(open) = state.inner.switcher_mut().open.as_mut() {
+        open.list.shown = Some(key);
+    }
+}
+
+/// Build the list surface: click-through, like the overview's hover card.
+fn create(state: &mut Loop, renderer: &mut GlesRenderer, extent: Size<i32, Physical>) -> Option<HandleId> {
+    let gpu = state.inner.environment.GPU.clone();
+    let id = state.inner.surface_mut().registry.as_mut().and_then(|reg| {
+        let handle = reg
+            .create_screen(
+                &gpu.as_str(),
+                WindowList::new(),
+                renderer,
+                Point::from((0, 0)),
+                extent,
+                Layer::SCENE.bits(),
+            )
+            .ok()?;
+        reg.set_passthrough_by_id(handle.id, true);
+        Some(handle.id)
+    })?;
+    if let Some(open) = state.inner.switcher_mut().open.as_mut() {
+        open.list.id = Some(id);
+    }
+    Some(id)
+}
+
+/// The switcher is down: drop the surface entirely.
+pub fn teardown(state: &mut Loop) {
+    let id = state.inner.switcher_mut().open.as_mut().and_then(|o| {
+        o.list.shown = None;
+        o.list.id.take()
+    });
+    let Some(id) = id else { return };
+    if let Some(reg) = state.inner.surface_mut().registry.as_mut() {
+        reg.destroy_by_id(id);
+    }
+}
