+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.interface/interface.mode/mode.rs
@@ -0,0 +1,57 @@
+//! Swapping the switcher's layout mode (bare TAB).
+//!
+//! A mode change rebuilds the CYCLE ORDER only — MRU by recency, or left to right
+//! around the camera. The sphere's arrangement is fixed for the session: each
+//! window keeps its cell, and `cell_of` is permuted to follow the new order
+//! rather than recomputed. So TAB changes what ALT+TAB walks and how the list
+//! reads, and nothing moves on the globe.
+
+use compositor_orchestration_core_state_base::Loop;
+use compositor_y5_switcher_interface_cycle::cycle::face_cell;
+use compositor_y5_switcher_state_base::base::{Mode, SWITCHER_MODE_MUT};
+
+/// Toggle the mode, rebuild the order and the placement, and keep the same
+/// WINDOW selected across the change.
+pub fn toggle(state: &mut Loop) {
+    let Some(mode) = state.inner.switcher().open.as_ref().map(|o| o.mode) else { return };
+    let next = if mode == Mode::Stack { Mode::Spatial } else { Mode::Stack };
+    *state.inner.kernel.get_mut(&SWITCHER_MODE_MUT) = next;
+    // Held by identity, not by position: the two orders are unrelated
+    // permutations, so carrying the index across would jump the selection to an
+    // unrelated window.
+    let held = state.inner.switcher().open.as_ref().and_then(|o| o.current());
+    // Built against `base`, the MRU snapshot, so neither mode inherits the other's
+    // ordering — stack always means recency, spatial always means what is on
+    // screen, however many times TAB is pressed.
+    let base = state.inner.switcher().open.as_ref().map(|o| o.base.clone()).unwrap_or_default();
+    let order = match next {
+        Mode::Stack => base.clone(),
+        Mode::Spatial => compositor_y5_switcher_layout_spatial::spatial::order(state, &base),
+    };
+    let cell = {
+        let Some(open) = state.inner.switcher_mut().open.as_mut() else { return };
+        open.mode = next;
+        // The ARRANGEMENT does not change: each window keeps the cell it already
+        // occupies, and `cell_of` is permuted to match the new order rather than
+        // rebuilt. Re-laying the globe under the user on every TAB was the thing
+        // that made the two modes read as different sphere layouts; they are not.
+        // It also means cell -> texture is untouched, so the scene needs no rebuild.
+        open.cell_of = order
+            .iter()
+            .map(|u| {
+                open.order
+                    .iter()
+                    .position(|o| o == u)
+                    .and_then(|i| open.cell_of.get(i).copied())
+                    .unwrap_or(0)
+            })
+            .collect();
+        open.order = order;
+        open.index = held
+            .and_then(|h| open.order.iter().position(|u| *u == h))
+            .unwrap_or_else(|| open.index.min(open.order.len().saturating_sub(1)));
+        open.quick = None; // a deliberate mode change ends the gesture
+        open.cell_of.get(open.index).copied().unwrap_or(0)
+    };
+    face_cell(state, cell);
+}
diff --git a/compositor.expansion/compositor.y5/y5.switcher/switcher.layout/layout.constant/constant.rs b/compositor.expansion/compositor.y5/y5.switcher/switcher.layout/layout.constant/constant.rs
