@@ -0,0 +1,33 @@
+//! One window's live cell texture: a dmabuf the compositor renders the window
+//! into, aliased to a `wgpu::Texture` the bevy cell material samples.
+//!
+//! The two handles are the SAME buffer seen through two APIs — GLES writes it,
+//! Vulkan reads it. That aliasing is what makes the cells live rather than
+//! snapshots: the bridge installs the wgpu texture into bevy exactly once, and
+//! from then on new pixels appear simply because the compositor drew them. Only
+//! a size change needs a new texture.
+//!
+//! Cycle-free by construction (it names no compositor type), so the state slot
+//! can hold it without dragging the render stack into `orchestration.core.state`.
+
+use compositor_support_bevy_core_alloc_base::AllocatedDmabuf;
+use std::sync::Arc;
+use uuid::Uuid;
+
+pub struct CellTexture {
+    /// The window this texture belongs to. Keyed by uuid rather than by position
+    /// so it survives the order being rebuilt (a TAB toggle) or an entry being
+    /// pruned — neither needs to touch the textures at all.
+    pub uuid: Uuid,
+    /// The buffer the window is rendered into. Held for its lifetime: dropping it
+    /// frees the underlying BO that `wgpu` is still sampling.
+    pub dmabuf: AllocatedDmabuf,
+    /// The same buffer as a wgpu texture, handed to the bevy bridge.
+    pub wgpu: Arc<wgpu::Texture>,
+}
+
+impl std::fmt::Debug for CellTexture {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("CellTexture").field("uuid", &self.uuid).finish()
+    }
+}
