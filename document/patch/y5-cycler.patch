index 00000000..731a0379
--- /dev/null
+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.three/three.glow/glow.rs
@@ -0,0 +1,87 @@
+//! The soft circular backdrop behind the globe: a disc carrying a blurred copy
+//! of the desktop it covers, fading to nothing at the rim.
+//!
+//! The falloff is PER-VERTEX rather than a texture or a custom shader, because
+//! `StandardMaterial` already multiplies its base colour by
+//! `Mesh::ATTRIBUTE_COLOR` when the mesh carries it — and by `base_color_texture`
+//! as well, so one disc gets both the blur and the fade for the cost of a mesh.
+//! No WGSL, no sampler, nothing to keep in step with the rest of the pipeline.
+//!
+//! The disc is sized to cover the render target EXACTLY at `GLOW_Z`, so its UVs
+//! map one-to-one onto the sphere's own sub-rect: the blurred desktop therefore
+//! lands on the pixels it was taken from rather than merely near them.
+
+use bevy::asset::RenderAssetUsages;
+use bevy::prelude::*;
+use bevy::render::mesh::{Indices, PrimitiveTopology};
+use compositor_y5_switcher_sphere_constant::{CAMERA_DISTANCE, CAMERA_FOV_RAD};
+
+/// Where the disc sits on the camera axis — just behind the sphere's far pole,
+/// so the globe always occludes the middle and the blur reads as a halo.
+pub const GLOW_Z: f32 = -1.05;
+
+/// Linear RGBA at the hub. Multiplies the blurred texture, so this is the "low
+/// light" tint rather than the colour itself; alpha reaches zero at the rim.
+pub const GLOW_COLOR: [f32; 4] = [0.62, 0.72, 1.00, 0.55];
+
+/// Fan segments. 64 is smooth at any size the overlay is drawn at.
+const SEGMENTS: u32 = 64;
+
+/// The disc radius that exactly spans the render target's HEIGHT at `GLOW_Z`.
+/// Derived rather than tuned: the camera sits at `CAMERA_DISTANCE`, so the
+/// half-extent at the disc's plane is `tan(fov/2) * (distance - z)`.
+pub fn cover_radius(camera_distance: f32) -> f32 {
+    (CAMERA_FOV_RAD * 0.5).tan() * (camera_distance - GLOW_Z)
+}
+
+/// The disc's scale for a given camera distance, relative to the mesh built at
+/// the resting one. Zoom MOVES the camera, so without this the backdrop would
+/// slide out of register with the desktop behind it as the user scrolls.
+pub fn cover_scale(camera_distance: f32) -> f32 {
+    cover_radius(camera_distance) / cover_radius(CAMERA_DISTANCE)
+}
+
+/// A triangle-fan disc: `color` at the hub fading to alpha 0 at the rim, with
+/// UVs spanning the disc's bounding square so a full-target texture registers.
+/// Faces +Z, so it needs no rotation to face the camera.
+pub fn disc_mesh(radius: f32, color: [f32; 4]) -> Mesh {
+    let mut pos = vec![[0.0, 0.0, 0.0]];
+    let mut nrm = vec![[0.0, 0.0, 1.0]];
+    let mut uv = vec![[0.5, 0.5]];
+    let mut col = vec![color];
+    for i in 0..SEGMENTS {
+        let a = i as f32 / SEGMENTS as f32 * std::f32::consts::TAU;
+        let (x, y) = (a.cos(), a.sin());
+        pos.push([x * radius, y * radius, 0.0]);
+        nrm.push([0.0, 0.0, 1.0]);
+        // v is flipped: texture rows run downward, the mesh's y runs up.
+        uv.push([(x + 1.0) * 0.5, (1.0 - y) * 0.5]);
+        col.push([color[0], color[1], color[2], 0.0]);
+    }
+    let mut idx: Vec<u32> = Vec::with_capacity(SEGMENTS as usize * 3);
+    for i in 0..SEGMENTS {
+        idx.extend_from_slice(&[0, i + 1, (i + 1) % SEGMENTS + 1]);
+    }
+    let mut mesh = Mesh::new(PrimitiveTopology::TriangleList, RenderAssetUsages::RENDER_WORLD);
+    mesh.insert_attribute(Mesh::ATTRIBUTE_POSITION, pos);
+    mesh.insert_attribute(Mesh::ATTRIBUTE_NORMAL, nrm);
+    mesh.insert_attribute(Mesh::ATTRIBUTE_UV_0, uv);
+    mesh.insert_attribute(Mesh::ATTRIBUTE_COLOR, col);
+    mesh.insert_indices(Indices::U32(idx));
+    mesh
+}
+
+/// The disc's material. `texture` is the blurred desktop when one could be made;
+/// without it the disc is a plain tinted glow. Never depth-writes — it is a
+/// backdrop, and writing depth would let it cut into the sphere in front of it.
+pub fn disc_material(texture: Option<Handle<Image>>) -> StandardMaterial {
+    StandardMaterial {
+        base_color: Color::WHITE,
+        base_color_texture: texture,
+        unlit: true,
+        alpha_mode: AlphaMode::Blend,
+        cull_mode: None,
+        depth_bias: -1.0,
+        ..default()
+    }
+}
