+//! On-screen placement and sizing of the switcher overlay, and the stack-list
+//! presentation. Everything here is compositor-side (physical pixels, alphas) —
+//! the sphere's own tunables live in `switcher.sphere/sphere.constant`.
+
+/// The globe's square side as a fraction of the output's SHORTER edge, then
+/// clamped. Proportionate on a 1080p panel (~453 px) and capped on 4K so the
+/// overlay stays an overlay rather than growing into a full-screen picker.
+pub const SPHERE_FRACTION: f64 = 0.42;
+pub const SPHERE_MIN_PX: i32 = 360;
+pub const SPHERE_MAX_PX: i32 = 900;
+
+/// Side of the square offscreen target each window's live content is rendered
+/// into, in pixels. At the sizes above a front-face cell is ~160-225 px, so 384
+/// is a comfortable 1.7-2.4x supersample; fill rate is the dominant per-frame
+/// cost here and it scales with the square, so do not raise this casually.
+pub const CELL_TEXTURE_PX: i32 = 384;
+
+/// Pointer travel (physical px) below which a press/release pair counts as a
+/// click rather than a drag.
+pub const CLICK_PX: f64 = 6.0;
+
+/// The stack list under the globe: how many entries, and each one's opacity.
+/// The list is CENTRED on the selection — `LIST_REACH` either side of it — so one
+/// neighbour is where the next ALT+TAB goes and the other is where you came from.
+/// Near an end of a short order the overhanging slots are simply dropped: never
+/// padded, and never wrapped round to show the same window twice.
+pub const LIST_REACH: usize = 2;
+pub const LIST_ROWS: usize = LIST_REACH * 2 + 1;
+pub const LIST_ALPHA: [f32; LIST_ROWS] = [0.32, 0.72, 1.0, 0.72, 0.32];
+
+/// Stack-list geometry (physical px). `LIST_W` is the vertical list's width;
+/// `LIST_STRIP_W` the horizontal strip's, which has to hold `LIST_ROWS` columns
+/// side by side. `LIST_GAP` separates the list from the bottom of the globe.
+pub const LIST_ROW_H: i32 = 34;
+pub const LIST_W: i32 = 420;
+pub const LIST_STRIP_W: i32 = 800;
+pub const LIST_GAP: i32 = 12;
+
+/// Side of the backdrop's offscreen target, in pixels. Deliberately TINY: it is
+/// magnified to the whole globe rect with linear filtering, and that
+/// magnification IS the blur. A separate blur pass would cost a second dmabuf
+/// and two more binds per frame to reach the same look.
+pub const BACKDROP_PX: i32 = 48;
