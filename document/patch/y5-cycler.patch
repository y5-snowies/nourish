diff --git a/compositor.expansion/compositor.y5/y5.switcher/switcher.texture/texture.backdrop/backdrop.rs b/compositor.expansion/compositor.y5/y5.switcher/switcher.texture/texture.backdrop/backdrop.rs
new file mode 100644
index 00000000..77d6a259
--- /dev/null
+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.texture/texture.backdrop/backdrop.rs
@@ -0,0 +1,96 @@
+//! The blurred desktop behind the globe.
+//!
+//! Rendered from the WINDOWS, not captured from the framebuffer — that is the
+//! whole trick. A framebuffer capture would include the switcher's own globe from
+//! the previous frame and feed back into itself; `draw_windows_into` draws from
+//! the clients' committed buffers and never the compositor's chrome, so this can
+//! be live without ever seeing itself.
+//!
+//! The blur is free: the target is `BACKDROP_PX` square — tiny — and the disc
+//! magnifies it across the globe rect with linear filtering, which is a box blur
+//! by another name. A real blur pass would cost a second dmabuf and two more
+//! binds a frame for the same soft wash.
+
+use compositor_orchestration_core_state_base::Loop;
+use compositor_orchestration_core_state_base::state::CoordinateTrait;
+use compositor_y5_switcher_layout_constant::BACKDROP_PX;
+use compositor_y5_switcher_state_base::base::CellTexture;
+use smithay::backend::renderer::gles::GlesRenderer;
+use smithay::desktop::Window;
+use smithay::utils::{Physical, Point, Size};
+use uuid::Uuid;
+
+/// The uuid the backdrop's texture is filed under. Nil: it belongs to no window,
+/// and keying it this way lets it share the session's texture list — and so its
+/// teardown — instead of needing a slot of its own.
+pub const BACKDROP_KEY: Uuid = Uuid::nil();
+
+/// Allocate the backdrop target if it is missing.
+pub fn ensure(state: &mut Loop, gles: &mut GlesRenderer) {
+    let have = state
+        .inner
+        .switcher()
+        .open
+        .as_ref()
+        .is_some_and(|o| o.textures.iter().any(|t| t.uuid == BACKDROP_KEY));
+    if have || state.inner.switcher().open.is_none() {
+        return;
+    }
+    let px = BACKDROP_PX.max(1) as u32;
+    let alloc = compositor_y5_switcher_texture_alloc::alloc::allocate_sized;
+    let Some(tex) = alloc(state, gles, BACKDROP_KEY, px) else { return };
+    if let Some(open) = state.inner.switcher_mut().open.as_mut() {
+        open.textures.push(tex);
+    }
+}
+
+/// The backdrop's own texture, for handing to the scene.
+pub fn texture(state: &Loop) -> Option<&CellTexture> {
+    state.inner.switcher().open.as_ref()?.textures.iter().find(|t| t.uuid == BACKDROP_KEY)
+}
+
+/// Redraw the desktop under the globe into the backdrop target. The globe's rect
+/// maps onto the square target, so a texel holds what sits behind the disc pixel
+/// sampling it — the disc's UVs span its bounding square, which is that rect.
+pub fn per_frame(state: &mut Loop, gles: &mut GlesRenderer) {
+    let Some(rect) = state.inner.switcher().open.as_ref().map(|o| o.rect) else { return };
+    if rect.size.w <= 0 || rect.size.h <= 0 {
+        return;
+    }
+    let px = BACKDROP_PX.max(1);
+    // World -> target: the rect is physical, so undo the output scale and the
+    // camera zoom the windows are drawn at, then fit that into the small square.
+    let ctx = state.size_ctx_all();
+    let fit = px as f64 / rect.size.w.max(1) as f64;
+    let world_to_target = ctx.scale * ctx.camera_zoom * fit;
+    let windows: Vec<(Window, Point<i32, Physical>)> = state
+        .inner
+        .space_state()
+        .state
+        .elements()
+        .filter_map(|w| {
+            let bbox = state.inner.space_state().state.element_bbox(w)?;
+            let t: compositor_y5_camera_transform_translate::transform::Transform =
+                (bbox.to_f64(), ctx).into();
+            let on_screen: smithay::utils::Rectangle<i32, Physical> = t.into();
+            on_screen.overlaps(rect).then(|| {
+                (
+                    w.clone(),
+                    Point::from((
+                        (((on_screen.loc.x - rect.loc.x) as f64) * fit).round() as i32,
+                        (((on_screen.loc.y - rect.loc.y) as f64) * fit).round() as i32,
+                    )),
+                )
+            })
+        })
+        .collect();
+    let Some(open) = state.inner.switcher_mut().open.as_mut() else { return };
+    let Some(tex) = open.textures.iter_mut().find(|t| t.uuid == BACKDROP_KEY) else { return };
+    compositor_y5_graphic_capture_interface::render::draw_windows_into(
+        gles,
+        &mut tex.dmabuf.dmabuf,
+        Size::<i32, Physical>::from((px, px)),
+        &windows,
+        world_to_target,
+    );
+}
