index 00000000..b4d3f7fe
--- /dev/null
+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.input/input.pointer/pointer.rs
@@ -0,0 +1,73 @@
+//! Switcher pointer motion and zoom. Clicks live next door in `input.click`.
+//!
+//! Modelled on the picker's EMBED pointer path, not its full-screen one. The
+//! full-screen picker dead-reckons its own pointer and warps the seat cursor to
+//! match; here the switcher is an overlay inside a live world, so the seat keeps
+//! owning the cursor and this only reads it. Warping would fight the compositor
+//! for a cursor the user can still see moving over their windows.
+
+use compositor_orchestration_core_state_base::Loop;
+use compositor_orchestration_core_state_base::state::CoordinateTrait;
+use compositor_y5_switcher_interface_base::base::is_open;
+use compositor_y5_switcher_sphere_constant::{ROTATE_SENSITIVITY, ZOOM_MAX, ZOOM_MIN, ZOOM_STEP};
+use compositor_y5_switcher_sphere_orient::orient;
+use smithay::backend::input::{Axis, InputBackend, PointerAxisEvent};
+use smithay::utils::{Logical, Physical, Point};
+
+
+/// The seat cursor in output-physical pixels — the space the globe's rect and
+/// the ray-cast both work in.
+pub fn seat_pointer(state: &mut Loop) -> Option<(f64, f64)> {
+    let loc: Point<f64, Logical> = state.state.seat.seat.get_pointer()?.current_location();
+    let ctx = state.size_ctx_all();
+    let t: compositor_y5_camera_transform_translate::transform::Transform = (loc, ctx).into();
+    let phys: Point<f64, Physical> = t.into();
+    Some((phys.x, phys.y))
+}
+
+/// Sync the tracked pointer from the seat and rotate while dragging. Called from
+/// both motion paths, and again before a press so a click that follows no motion
+/// still hit-tests against a real position rather than the session's initial one.
+pub fn motion(state: &mut Loop) {
+    let Some((x, y)) = seat_pointer(state) else { return };
+    let h = state.size_ctx_all().screen_size_physical.1;
+    let k = ROTATE_SENSITIVITY as f64 / h.max(1.0);
+    let inc = state.inner.switcher_mut().open.as_mut().and_then(|o| {
+        let prev = o.pointer;
+        o.pointer = (x, y);
+        o.drag.is_some().then(|| (o.orientation, ((x - prev.0) * k) as f32, ((y - prev.1) * k) as f32))
+    });
+    if let Some((o, dx, dy)) = inc {
+        let (next, spin) = orient::drag(o, dx, dy);
+        if let Some(open) = state.inner.switcher_mut().open.as_mut() {
+            // Free-look: the target follows, so releasing does not animate back.
+            (open.orientation, open.target) = (next, next);
+            open.spin = spin; // the last increment seeds release momentum
+        }
+    }
+}
+
+/// Scroll zooms the globe. Consumed while open so the canvas never pans under it.
+pub fn axis<I: InputBackend>(event: &<I as InputBackend>::PointerAxisEvent, state: &mut Loop) -> bool {
+    if !is_open(state) {
+        return false;
+    }
+    let delta = event
+        .amount_v120(Axis::Vertical)
+        .map(|v| v / 120.0)
+        .or_else(|| event.amount(Axis::Vertical).map(|a| a / 8.0))
+        .unwrap_or(0.0) as f32;
+    if let Some(open) = state.inner.switcher_mut().open.as_mut() {
+        open.zoom = (open.zoom - (delta * ZOOM_STEP).clamp(-0.2, 0.2)).clamp(ZOOM_MIN, ZOOM_MAX);
+    }
+    true
+}
+
+/// Motion is observed but NOT consumed: the cursor must keep tracking normally
+/// over the live desktop the switcher is drawn on top of.
+pub fn moved(state: &mut Loop) -> bool {
+    if is_open(state) {
+        motion(state);
+    }
+    false
+}
