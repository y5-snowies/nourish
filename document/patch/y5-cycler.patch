diff --git a/compositor.expansion/compositor.y5/y5.switcher/switcher.input/input.click/click.rs b/compositor.expansion/compositor.y5/y5.switcher/switcher.input/input.click/click.rs
new file mode 100644
index 00000000..b509dd7a
--- /dev/null
+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.input/input.click/click.rs
@@ -0,0 +1,84 @@
+//! Switcher clicks: a click picks a cell, clicking the already-selected one
+//! commits, and a press outside the globe dismisses.
+//!
+//! The press outside being a dismiss rather than a fall-through is deliberate:
+//! while the switcher is up it owns the pointer, so a stray click cannot reach a
+//! window behind it and focus something the user did not choose.
+
+use compositor_orchestration_core_state_base::Loop;
+use compositor_y5_switcher_input_pointer::pointer::motion;
+use compositor_y5_switcher_interface_base::base::is_open;
+use compositor_y5_switcher_layout_constant::CLICK_PX;
+use compositor_y5_switcher_layout_rect::rect;
+use compositor_y5_switcher_sphere_orient::orient;
+use smithay::backend::input::{ButtonState, InputBackend, PointerButtonEvent};
+
+const BTN_LEFT: u32 = 0x110;
+
+/// The cell under the pointer, or `None` off the globe. The pointer is made
+/// rect-LOCAL first: the instance is a sub-rect, and `pick_cell` works in
+/// render-target pixels, so an output-space pointer would ray-cast into the
+/// wrong space entirely.
+fn cell_under(state: &mut Loop) -> Option<usize> {
+    let open = state.inner.switcher().open.as_ref()?;
+    let (r, p, o, z) = (open.rect, open.pointer, open.orientation, open.zoom);
+    compositor_y5_switcher_sphere_pick::pick::pick_cell(
+        rect::to_local(p, r),
+        rect::target_size(r),
+        o,
+        z,
+    )
+}
+
+/// Returns true when the switcher consumed the button.
+pub fn button<I: InputBackend>(event: &<I as InputBackend>::PointerButtonEvent, state: &mut Loop) -> bool {
+    if !is_open(state) {
+        return false;
+    }
+    if event.button_code() != BTN_LEFT {
+        return true; // while open, no button reaches the desktop
+    }
+    motion(state);
+    if event.state() == ButtonState::Pressed {
+        let inside = state
+            .inner
+            .switcher()
+            .open
+            .as_ref()
+            .is_some_and(|o| rect::contains(o.pointer, o.rect));
+        if !inside {
+            // Click-away dismiss, like Escape: no focus change, MRU untouched.
+            compositor_y5_switcher_interface_base::base::close(state);
+            return true;
+        }
+        compositor_y5_switcher_interface_cycle::cycle::disarm(state);
+        if let Some(open) = state.inner.switcher_mut().open.as_mut() {
+            open.drag = Some(open.pointer);
+            open.spin = orient::Orient::ZERO;
+        }
+        return true;
+    }
+    // Release: a short press-release over a cell is a click, anything longer was
+    // a rotation and must not also select.
+    let travel = state
+        .inner
+        .switcher_mut()
+        .open
+        .as_mut()
+        .and_then(|o| o.drag.take().map(|s| (s, o.pointer)));
+    let Some((start, pos)) = travel else { return true };
+    if (pos.0 - start.0).hypot(pos.1 - start.1) >= CLICK_PX {
+        return true;
+    }
+    if let Some(cell) = cell_under(state) {
+        if state.inner.switcher().open.as_ref().and_then(|o| o.selected) == Some(cell) {
+            // Clicking the cell already selected is the commit, matching the
+            // picker's own second-click-enters gesture.
+            compositor_y5_switcher_interface_commit::commit::commit(state);
+        } else {
+            compositor_y5_switcher_interface_cycle::cycle::select_cell(state, cell);
+        }
+    }
+    true
+}
+
