+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.interface/interface.base/base.rs
@@ -0,0 +1,100 @@
+//! Opening and closing the ALT+TAB switcher.
+//!
+//! `open` seeds the session from the MRU stack — in BOTH modes, since recency is
+//! what decides where you start even when the layout reads spatially. Stepping,
+//! and rebuilding the order when TAB changes mode, live in `interface.cycle`.
+
+use compositor_orchestration_core_state_base::state::CoordinateTrait;
+use compositor_orchestration_core_state_base::Loop;
+use compositor_y5_switcher_layout_place::place;
+use compositor_y5_switcher_sphere_orient::orient::{self, Orient};
+use compositor_y5_switcher_state_base::base::{Mode, SwitcherOpen, SWITCHER_MODE};
+use smithay::utils::{Point, Rectangle, Size};
+
+/// Whether another overlay owns the screen and the keyboard. The overview
+/// consumes EVERY key while visible, so a switcher opened underneath it could
+/// never be driven; the world picker is a different world entirely, and a locked
+/// or suspending session has no business cycling windows.
+pub fn blocked(state: &Loop) -> bool {
+    state.inner.overview().visible
+}
+
+pub fn is_open(state: &Loop) -> bool {
+    state.inner.switcher().open.is_some()
+}
+
+/// Open on the focused window, or on the visible window nearest the screen
+/// centre when nothing holds focus. Deliberately does NOT advance: the first
+/// ALT+TAB shows where you are, and it takes a second press to start rotating.
+pub fn open(state: &mut Loop) {
+    if blocked(state) || is_open(state) {
+        return;
+    }
+    let size = state.size_ctx_all().screen_size_physical;
+    let head = compositor_y5_switcher_stack_order::order::focused(state)
+        .or_else(|| compositor_y5_switcher_stack_center::center::fallback(state, size));
+    let base = compositor_y5_switcher_stack_order::order::snapshot(state, head);
+    if base.is_empty() {
+        return;
+    }
+    // The mode is a session preference, so a switcher can OPEN in either one —
+    // and its order has to match. Building the MRU order regardless was what
+    // showed a positional strip in recency order, rotated to start at the
+    // selection, which reads as an arbitrary cycle rather than as the desktop.
+    let mode = *state.inner.kernel.get(&SWITCHER_MODE);
+    let order = match mode {
+        Mode::Stack => base.clone(),
+        Mode::Spatial => compositor_y5_switcher_layout_spatial::spatial::order(state, &base),
+    };
+    // Positional: each window takes the cell lying in its own direction across the
+    // desktop, so the sphere mirrors it. A function of the windows alone, so it is
+    // the same wherever the camera is — and computed once, since TAB never re-lays.
+    let cell_of = place::cells(state, &order);
+    // NOT 0: only the MRU order puts the current window first. In a positional
+    // order it sits wherever it does on the desktop, and the cursor has to find it.
+    let index = head.and_then(|h| order.iter().position(|u| *u == h)).unwrap_or(0);
+    let faced = orient::face(cell_of[index], 0.0);
+    let count = order.len();
+    state.inner.switcher_mut().open = Some(SwitcherOpen {
+        base,
+        selected: Some(cell_of[index]),
+        order,
+        index,
+        cell_of,
+        mode,
+        // Placed by the draw phase, which is what knows the output size; a stale
+        // rect here would misplace picking after a mode change.
+        rect: Rectangle::new(Point::from((0, 0)), Size::from((0, 0))),
+        orientation: faced,
+        target: faced,
+        spin: Orient::ZERO,
+        zoom: 1.0,
+        pointer: (0.0, 0.0),
+        drag: None,
+        textures: Vec::new(),
+        list: Default::default(),
+        bevy: None,
+        // Armed, with no advance yet: releasing ALT now leaves the sphere up.
+        quick: Some(0),
+        step: std::time::Instant::now(),
+    });
+    info!("switcher: open, {} window(s)", count);
+}
+
+/// Drop the session without changing focus — cancelling must leave the MRU
+/// exactly as it was, or Escape would silently reorder the stack.
+///
+/// Tears down the bevy instance and the list surface FIRST. Both are reachable
+/// only through `open`, so clearing it before releasing them would strand a live
+/// scene and a live iced surface with no handle left to destroy them by — which
+/// is what every cancel path (Escape, click-away, an emptied order) would have
+/// leaked. Callers therefore never need to release anything themselves.
+pub fn close(state: &mut Loop) {
+    if state.inner.switcher().open.is_none() {
+        return;
+    }
+    compositor_y5_switcher_scene_destroy::destroy::destroy(state);
+    compositor_y5_switcher_draw_list::list::teardown(state);
+    state.inner.switcher_mut().open = None;
+    info!("switcher: close");
+}
