+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.draw/draw.frame/frame.rs
@@ -0,0 +1,95 @@
+//! Switcher frame integration: the orchestration scene calls `prepare` in the
+//! GLES phase and `push` when lowering the content band. Unlike the overview this
+//! never OWNS the band — the desktop behind stays live, so it only adds nodes.
+
+use compositor_orchestration_core_state_base::Loop;
+use compositor_orchestration_draw_layer_base::base::Layer;
+use compositor_support_bevy_core_compositor_base::Transform;
+use compositor_y5_switcher_draw_push::push::Prepared;
+use compositor_y5_switcher_layout_rect::rect;
+use smithay::backend::renderer::gles::GlesRenderer;
+use smithay::utils::{Physical, Point, Size};
+
+/// Largest frame step the motion may see: a stall (mode set, resume) would
+/// otherwise deliver one enormous dt and teleport the globe.
+const DT_MAX: f32 = 0.1;
+
+/// Active monitor only. `prepare` runs once PER OUTPUT, so acting on every pass
+/// would rebuild the sub-rect instance at each monitor's size in turn and never
+/// settle. `render_output == None` is a winit/single pass — the active one.
+fn on_active_output(s: &Loop) -> bool {
+    s.inner.render_output.as_ref().is_none_or(|k| *k == s.inner.active_output_key())
+}
+
+/// GLES phase: keep the sphere instance in step with the session and the output,
+/// advance the motion, and render the instance.
+pub fn prepare(state: &mut Loop, gles: &mut GlesRenderer, size: Size<i32, Physical>) -> Prepared {
+    if !on_active_output(state) {
+        return Prepared::default();
+    }
+    if !compositor_y5_switcher_interface_base::base::is_open(state) {
+        // Idempotent: reclaims the instance the first frame after a close.
+        compositor_y5_switcher_scene_destroy::destroy::destroy(state);
+        compositor_y5_switcher_draw_list::list::teardown(state);
+        return Prepared::default();
+    }
+    compositor_y5_switcher_draw_prune::prune::prune(state);
+    if !compositor_y5_switcher_interface_base::base::is_open(state) {
+        return Prepared::default();
+    }
+
+    // Textures first: the scene bridges them at build time, so they must exist
+    // before it is created or the first frame bakes in `None`.
+    compositor_y5_switcher_texture_alloc::alloc::ensure(state, gles);
+    compositor_y5_switcher_texture_backdrop::backdrop::ensure(state, gles);
+
+    // The rect is re-derived each frame, so a mode or monitor change moves the
+    // globe; a changed rect means the instance has the wrong aspect and must go.
+    // A TAB toggle needs no rebuild: it reorders the cycle without moving a
+    // window to another cell, so cell -> texture is unchanged.
+    let wanted = rect::sphere_rect(size);
+    let stale = state.inner.switcher().open.as_ref().is_some_and(|o| o.rect != wanted);
+    if stale {
+        compositor_y5_switcher_scene_destroy::destroy::destroy(state);
+        if let Some(open) = state.inner.switcher_mut().open.as_mut() {
+            open.rect = wanted;
+        }
+    }
+    compositor_y5_switcher_scene_create::create::create(state, gles, wanted);
+    // Draw each window into its cell; the bevy side needs no prompting, since
+    // its textures alias the dmabufs just written.
+    compositor_y5_switcher_texture_render::render::per_frame(state, gles);
+    // The soft backdrop: the desktop under the globe, drawn tiny so the disc's
+    // magnification blurs it.
+    compositor_y5_switcher_texture_backdrop::backdrop::per_frame(state, gles);
+
+    let now = std::time::Instant::now();
+    let dt = match state.inner.switcher_mut().open.as_mut() {
+        Some(open) => {
+            let dt = now.duration_since(open.step).as_secs_f32().min(DT_MAX);
+            open.step = now;
+            dt
+        }
+        None => return Prepared::default(),
+    };
+    compositor_y5_switcher_interface_cycle::cycle::advance(state, dt);
+    compositor_y5_switcher_scene_command::command::push_transform(state);
+    // ...and the selection. Pushing this only at scene creation is what pinned
+    // the outline to the cell the switcher opened on: every later ALT+TAB moved
+    // `selected` compositor-side, the scene never heard about it, and the
+    // highlight sat on a cell that had since rotated out of view.
+    compositor_y5_switcher_scene_command::command::push_selected(state);
+    // The stack list, under the globe: an ICED_SCREEN surface, so it composites
+    // above the sphere without needing a node of its own in the plan.
+    compositor_y5_switcher_draw_list::list::per_frame(state, gles, size);
+    state.schedule_redraw_post_vblank(); // the globe animates while it is up
+
+    let gpu = state.inner.environment.GPU.clone();
+    let transform = Transform { zoom: 1.0, position: Point::new(0.0, 0.0) };
+    let bevy = compositor_y5_switcher_system_base::base::scene_registry(&mut state.inner.worlds)
+        .and_then(|reg| {
+            reg.render_all(&gpu, gles, transform, size.to_f64(), Layer::SWITCHER_SCENE.bits()).ok()
+        })
+        .unwrap_or_default();
+    Prepared { bevy }
+}
