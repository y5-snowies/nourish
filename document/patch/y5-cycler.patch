+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.interface/interface.cycle/cycle.rs
@@ -0,0 +1,92 @@
+//! Moving through the switcher: stepping the stack, re-laying the cells, and the
+//! per-frame motion of the globe.
+//!
+//! `step` moves a cursor through the current mode's order and `select_*` moves it
+//! by naming a cell instead. Swapping the mode — which rebuilds the order itself —
+//! lives next door in `interface.mode`.
+
+use compositor_orchestration_core_state_base::Loop;
+use compositor_y5_switcher_sphere_constant::{APPROACH_RATE, SPIN_DECAY};
+use compositor_y5_switcher_sphere_orient::orient::{self, Orient};
+
+/// Break the quick-swap gesture. Called by every deliberate navigation: once the
+/// user has steered by hand, releasing ALT must not commit for them.
+pub fn disarm(state: &mut Loop) {
+    if let Some(open) = state.inner.switcher_mut().open.as_mut() {
+        open.quick = None;
+    }
+}
+
+/// Point the globe at `cell` and record it as the selection. Public because
+/// `interface.mode` re-faces after rebuilding the order.
+pub fn face_cell(state: &mut Loop, cell: usize) {
+    let Some(open) = state.inner.switcher_mut().open.as_mut() else { return };
+    open.selected = Some(cell);
+    open.target = orient::face(cell, open.orientation.yaw);
+    open.spin = Orient::ZERO;
+}
+
+/// Step the cursor through the current mode's order. `delta` is +1 for ALT+TAB,
+/// -1 for ALT+SHIFT+TAB. Wraps, so a short order cycles rather than stalling.
+pub fn step(state: &mut Loop, delta: i32) {
+    let Some(open) = state.inner.switcher_mut().open.as_mut() else { return };
+    let len = open.order.len();
+    if len == 0 {
+        return;
+    }
+    let forward = delta.rem_euclid(len as i32) as usize;
+    open.index = (open.index + forward) % len;
+    // Still the quick-swap gesture: this IS the ALT+TAB it is made of.
+    if let Some(n) = open.quick.as_mut() {
+        *n += 1;
+    }
+    let cell = open.cell_of[open.index];
+    face_cell(state, cell);
+}
+
+/// Move the SELECTION to a cell named directly (an arrow key or a click) and pull
+/// the cursor along, so a following ALT+TAB continues from where the user is
+/// looking rather than from where they last tabbed to.
+pub fn select_cell(state: &mut Loop, cell: usize) {
+    disarm(state);
+    let index = state.inner.switcher().open.as_ref().and_then(|o| o.index_of_cell(cell));
+    if let (Some(i), Some(open)) = (index, state.inner.switcher_mut().open.as_mut()) {
+        open.index = i;
+    }
+    face_cell(state, cell);
+}
+
+/// Move the selection one step in a SCREEN direction (`du` right, `dv` up).
+/// Swept against `target` rather than the live orientation, so a held key walks
+/// cleanly instead of chasing a globe that is still gliding.
+pub fn select_direction(state: &mut Loop, du: i32, dv: i32) {
+    disarm(state);
+    let Some((cell, target)) = state
+        .inner
+        .switcher()
+        .open
+        .as_ref()
+        .and_then(|o| o.selected.map(|c| (c, o.target)))
+    else {
+        return;
+    };
+    let next = compositor_y5_switcher_sphere_navigate::navigate::neighbor(cell, du, dv, target);
+    select_cell(state, next);
+}
+
+/// One dt-stepped frame of motion: coast out a drag-release, else glide toward
+/// the faced cell. Rates are per-second so this is refresh-rate independent.
+pub fn advance(state: &mut Loop, dt: f32) {
+    let Some(open) = state.inner.switcher_mut().open.as_mut() else { return };
+    if open.drag.is_some() {
+        return;
+    }
+    if orient::spinning(open.spin) {
+        let (next, spin) = orient::momentum(open.orientation, open.spin, SPIN_DECAY, dt);
+        open.orientation = next;
+        open.spin = spin;
+        open.target = next;
+    } else {
+        open.orientation = orient::approach(open.orientation, open.target, APPROACH_RATE, dt);
+    }
+}
