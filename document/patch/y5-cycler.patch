@@ -0,0 +1,53 @@
+//! Committing the switcher: focus the selected window and travel the camera to it.
+//!
+//! Order matters. The overlay is torn down BEFORE focus moves and the camera
+//! travels, so the `NavRequest` the travel issues never lands in a frame that
+//! still holds a half-dismantled session.
+//!
+//! The focus half is the canonical four-part recipe from
+//! `y5.navigator/navigator.travel/travel.machine/view_directional.rs:225-249`.
+//! All four parts are load-bearing and have to stay in step: smithay's `Space`
+//! order, the `DrawOrder` z-authority, per-window activation, and the seat. The
+//! `raise_drawable` is also what makes the chosen window the new MRU head, so
+//! the next ALT+TAB opens on it — cancelling, which skips all of this, correctly
+//! leaves the order untouched.
+
+use compositor_orchestration_core_state_base::Loop;
+use compositor_y5_window_interface_record::window::LoopWindow;
+use smithay::utils::SERIAL_COUNTER;
+
+/// Focus the selected window, travel to it, and close. No-op without a session
+/// or when the selection no longer resolves to a live window.
+pub fn commit(state: &mut Loop) {
+    let uuid = state.inner.switcher().open.as_ref().and_then(|o| o.current());
+    let window = uuid.and_then(|u| compositor_y5_switcher_stack_order::order::window_of(state, u));
+    let Some(window) = window else {
+        // Nothing to go to — treat it as a cancel rather than stranding the globe.
+        compositor_y5_switcher_interface_base::base::close(state);
+        return;
+    };
+
+    // `close` releases the scene and the list surface as well, so by here the
+    // overlay is fully gone and the travel below lands in a clean frame.
+    compositor_y5_switcher_interface_base::base::close(state);
+
+    state.inner.space_state_mut().state.raise_element(&window, true);
+    if let Some(uuid) = window.uuid() {
+        state.inner.raise_drawable(uuid);
+    }
+    for w in state.inner.space_state().state.elements() {
+        w.set_activated(w == &window);
+        if let Some(toplevel) = w.toplevel() {
+            toplevel.send_pending_configure();
+        }
+    }
+    if let Some(surface) = window.toplevel().map(|t| t.wl_surface().clone())
+        && let Some(kb) = state.state.seat.seat.get_keyboard()
+    {
+        kb.set_focus(&mut state.state, Some(surface), SERIAL_COUNTER.next_serial());
+    }
+
+    compositor_y5_navigator_interface_base::interface::travel_to_window(state, &window);
+    state.schedule_redraw_post_vblank();
+    info!("switcher: commit {:?}", uuid);
+}
