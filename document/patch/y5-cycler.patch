+//! Bevy resources, components and the external command for the switcher scene.
+//!
+//! Shaped after `y5.picker/picker.three/three.state/state.rs`, minus the "+"
+//! glyph (which means "create a world" and has no switcher analogue) and minus
+//! the idle-sway clock — the switcher's globe is only ever moved deliberately.
+
+use bevy::prelude::*;
+
+/// Scene config, inserted at build time. `cells[i]` is the bridged live texture
+/// for cell `i` (None → no texture, so an occupied cell falls back to a solid
+/// patch and an unoccupied one draws nothing but wireframe).
+#[derive(Resource)]
+pub struct SwitcherConfig {
+    pub output_handle: Handle<Image>,
+    pub output_aspect: f32,
+    pub cells: Vec<Option<Handle<Image>>>,
+    /// The blurred desktop behind the globe, bridged like a cell. `None` when it
+    /// could not be allocated — the disc is then a plain tinted glow.
+    pub backdrop: Option<Handle<Image>>,
+    /// Per-cell occupancy: the cell holds a window.
+    pub occupied: Vec<bool>,
+}
+
+/// The sphere's transform, driven authoritatively from the compositor —
+/// orientation, momentum and zoom live there so click-picking stays aligned with
+/// what is drawn. `orientation` is a quaternion (xyzw); the camera is static at +Z.
+#[derive(Resource)]
+pub struct SwitcherTransform {
+    pub orientation: [f32; 4],
+    /// Camera zoom: distance = CAMERA_DISTANCE / zoom.
+    pub zoom: f32,
+}
+
+impl Default for SwitcherTransform {
+    fn default() -> Self {
+        Self { orientation: [0.0, 0.0, 0.0, 1.0], zoom: 1.0 }
+    }
+}
+
+/// The selected cell. Drives the outline.
+#[derive(Resource, Default)]
+pub struct SwitcherSelected(pub Option<usize>);
+
+/// The selection-outline mesh handle, rebuilt to the selected cell's curved
+/// border when the selection changes.
+#[derive(Resource)]
+pub struct SwitcherOutlineMesh(pub Handle<Mesh>);
+
+/// The rotating parent of all sphere geometry (cells, wireframe, outline). The
+/// glow disc is deliberately NOT a child: it is a backdrop, so it must not spin.
+#[derive(Component)]
+pub struct SwitcherRoot;
+
+/// The static camera.
+#[derive(Component)]
+pub struct SwitcherCamera;
+
+/// The soft backdrop disc. Outside the rotating root, and rescaled with zoom so
+/// it stays registered with the desktop it is a blurred copy of.
+#[derive(Component)]
+pub struct SwitcherGlow;
+
+/// The selection outline (repositioned to the selected cell).
+#[derive(Component)]
+pub struct SwitcherOutline;
+
+/// External command dispatched from the compositor side.
+#[derive(Debug)]
+pub enum SwitcherCommand {
+    /// Set or clear the selected cell.
+    SetSelected(Option<usize>),
+    /// Set the sphere's absolute transform (the compositor is authoritative).
+    SetTransform { orientation: [f32; 4], zoom: f32 },
+}
