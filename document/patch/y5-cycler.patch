diff --git a/compositor.extension/compositor.monitor/monitor.overview/overview.ui/ui.list/list.rs b/compositor.extension/compositor.monitor/monitor.overview/overview.ui/ui.list/list.rs
new file mode 100644
index 00000000..ab8ed9e0
--- /dev/null
+++ b/compositor.extension/compositor.monitor/monitor.overview/overview.ui/ui.list/list.rs
@@ -0,0 +1,152 @@
+//! `WindowList`: the ALT+TAB switcher's stack list — the selected window and its
+//! neighbours in the cycle order, fading out with distance from the selection.
+//!
+//! Centred rather than top-anchored: one side is what the next ALT+TAB reaches
+//! and the other is where you just came from, and both are worth seeing. Fading
+//! symmetrically is what says "these are context, that one is the choice".
+//!
+//! The axis follows the switcher's mode — a vertical list for the MRU stack, a
+//! horizontal strip of columns for the camera-centred layout, so the list reads
+//! the same way the sphere is arranged. The host decides which; this only draws.
+//!
+//! Rows arrive fully resolved (title, icon, alpha). Like `WindowCard` this does
+//! no icon lookup of its own and shows nothing when the host had nothing.
+
+use compositor_monitor_overview_ui_hover::CardIcon;
+use compositor_support_iced_core_engine_base::{IcedUi, Renderer};
+use iced_core::{alignment, Background, Border, Color, ContentFit, Element, Length, Padding, Theme};
+use iced_widget::{container, image, svg, text, Column, Row, Space};
+
+const ICON: f32 = 20.0;
+/// Column width in the horizontal strip. Fixed so columns line up regardless of
+/// title length; the title ellipsises inside it.
+const COLUMN_W: f32 = 150.0;
+
+/// One entry: what to show, and how present it is. `alpha` is the host's fade —
+/// 1.0 for the selection, less either side of it.
+#[derive(Debug, Clone)]
+pub struct ListRow {
+    pub title: String,
+    pub icon: Option<CardIcon>,
+    pub alpha: f32,
+    pub selected: bool,
+}
+
+#[derive(Debug, Clone)]
+pub enum WindowListMessage {
+    /// Replace the whole list, and say which way it runs.
+    Set { rows: Vec<ListRow>, horizontal: bool },
+}
+
+#[derive(Default)]
+pub struct WindowList {
+    rows: Vec<ListRow>,
+    horizontal: bool,
+}
+
+impl WindowList {
+    pub fn new() -> Self {
+        Self::default()
+    }
+}
+
+impl IcedUi for WindowList {
+    type Message = WindowListMessage;
+
+    fn update(&mut self, message: Self::Message) {
+        let WindowListMessage::Set { rows, horizontal } = message;
+        self.rows = rows;
+        self.horizontal = horizontal;
+    }
+
+    fn view(&self) -> Element<'_, Self::Message, Theme, Renderer> {
+        // Empty content draws NOTHING rather than the host hiding the surface: a
+        // hidden instance loses its GPU ring, and this changes on every keypress.
+        if self.rows.is_empty() {
+            return container(Space::new()).width(Length::Fill).height(Length::Fill).into();
+        }
+        let cells: Vec<Element<'_, Self::Message, Theme, Renderer>> =
+            self.rows.iter().map(|r| entry(r, self.horizontal)).collect();
+        let body: Element<'_, Self::Message, Theme, Renderer> = if self.horizontal {
+            Row::with_children(cells).spacing(8).align_y(alignment::Vertical::Center).into()
+        } else {
+            Column::with_children(cells).spacing(4).into()
+        };
+        container(body)
+            .width(Length::Fill)
+            .height(Length::Fill)
+            .align_x(alignment::Horizontal::Center)
+            .align_y(alignment::Vertical::Top)
+            .into()
+    }
+}
+
+/// One list entry. The selection carries a plate behind it; the rest are bare, so
+/// the fade alone separates them and nothing competes with the sphere.
+fn entry(row: &ListRow, horizontal: bool) -> Element<'_, WindowListMessage, Theme, Renderer> {
+    let a = row.alpha.clamp(0.0, 1.0);
+    let mut parts: Vec<Element<'_, WindowListMessage, Theme, Renderer>> = Vec::new();
+    match &row.icon {
+        Some(CardIcon::Pixels { width, height, rgba }) => parts.push(
+            image(image::Handle::from_rgba(
+                *width,
+                *height,
+                iced_core::Bytes::from(rgba.as_ref().clone()),
+            ))
+            .width(Length::Fixed(ICON))
+            .height(Length::Fixed(ICON))
+            .opacity(a)
+            .content_fit(ContentFit::Contain)
+            .into(),
+        ),
+        Some(CardIcon::File(path)) if is_svg(path) => parts.push(
+            svg(svg::Handle::from_path(path.clone()))
+                .width(Length::Fixed(ICON))
+                .height(Length::Fixed(ICON))
+                .opacity(a)
+                .content_fit(ContentFit::Contain)
+                .into(),
+        ),
+        Some(CardIcon::File(path)) => parts.push(
+            image(image::Handle::from_path(path.clone()))
+                .width(Length::Fixed(ICON))
+                .height(Length::Fixed(ICON))
+                .opacity(a)
+                .content_fit(ContentFit::Contain)
+                .into(),
+        ),
+        None => {}
+    }
+    parts.push(
+        text(row.title.clone())
+            .size(13)
+            .wrapping(text::Wrapping::None)
+            .ellipsis(text::Ellipsis::End)
+            .style(move |_t: &Theme| text::Style {
+                color: Some(Color::from_rgba(0.93, 0.95, 0.99, a)),
+            })
+            .into(),
+    );
+    let inner = Row::with_children(parts).spacing(8).align_y(alignment::Vertical::Center);
+    let plate = row.selected;
+    let mut c = container(inner)
+        .padding(Padding { top: 5.0, bottom: 5.0, left: 9.0, right: 11.0 })
+        .style(move |_t| container::Style {
+            background: plate
+                .then(|| Background::Color(Color::from_rgba(0.09, 0.10, 0.13, 0.94 * a))),
+            border: Border {
+                color: Color::from_rgba(1.0, 1.0, 1.0, if plate { 0.16 * a } else { 0.0 }),
+                width: if plate { 1.0 } else { 0.0 },
+                radius: 7.0.into(),
+            },
+            ..Default::default()
+        });
+    if horizontal {
+        c = c.width(Length::Fixed(COLUMN_W));
+    }
+    c.into()
+}
+
+fn is_svg(path: &std::path::Path) -> bool {
+    path.extension().and_then(|s| s.to_str()).map(|s| s.eq_ignore_ascii_case("svg")).unwrap_or(false)
+}
