diff --git a/compositor.expansion/compositor.y5/y5.switcher/switcher.stack/stack.order/order.rs b/compositor.expansion/compositor.y5/y5.switcher/switcher.stack/stack.order/order.rs
new file mode 100644
index 00000000..8f135828
--- /dev/null
+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.stack/stack.order/order.rs
@@ -0,0 +1,54 @@
+//! The MRU window stack the switcher cycles through, snapshotted at open.
+//!
+//! Source is `Loop::drawable_order()`, the world's z-order authority. Filtered to
+//! ids that resolve to a live `Window` it IS a raise-recency order: windows all
+//! register at `DrawLayer::CONTENT`, so the tier term in `DrawOrder::ordered()`
+//! collapses and the non-window drawables (group frames, iced overlays,
+//! placeholders) drop out — and every focus path raises. Two paths are known to
+//! diverge, both travelling without raising: the overview's activate, and dock
+//! activation. If that becomes visible, the fix is a real focus-recency ledger
+//! rather than more filtering here.
+
+use compositor_orchestration_core_state_base::Loop;
+use compositor_y5_switcher_sphere_constant::CELL_COUNT;
+use compositor_y5_window_interface_record::window::LoopWindow;
+use smithay::desktop::Window;
+use uuid::Uuid;
+
+/// The keyboard-focused window, if a client toplevel holds focus.
+pub fn focused(state: &Loop) -> Option<Uuid> {
+    let surface = state.state.seat.seat.get_keyboard().and_then(|kb| kb.current_focus())?;
+    state
+        .inner
+        .space_state()
+        .state
+        .elements()
+        .find(|w| w.toplevel().map(|t| t.wl_surface() == &surface).unwrap_or(false))
+        .and_then(|w| w.uuid())
+}
+
+/// Resolve a uuid back to the live window it names.
+pub fn window_of(state: &Loop, uuid: Uuid) -> Option<Window> {
+    state.inner.space_state().state.elements().find(|w| w.uuid() == Some(uuid)).cloned()
+}
+
+/// The cycle order: `head` first, then the remaining windows by raise recency,
+/// capped at the cell count. `head` is normally the focused window, so index 0
+/// is where you already are and index 1 is where you were before — the ordering
+/// every alt-tab is expected to have.
+pub fn snapshot(state: &Loop, head: Option<Uuid>) -> Vec<Uuid> {
+    let live: Vec<Uuid> = state.inner.space_state().state.elements().filter_map(|w| w.uuid()).collect();
+    let mut out: Vec<Uuid> = Vec::with_capacity(live.len().min(CELL_COUNT));
+    if let Some(h) = head.filter(|h| live.contains(h)) {
+        out.push(h);
+    }
+    for uuid in state.inner.drawable_order() {
+        if out.len() >= CELL_COUNT {
+            break;
+        }
+        if live.contains(&uuid) && !out.contains(&uuid) {
+            out.push(uuid);
+        }
+    }
+    out
+}
diff --git a/compositor.expansion/compositor.y5/y5.switcher/switcher.state/state.base/base.rs b/compositor.expansion/compositor.y5/y5.switcher/switcher.state/state.base/base.rs
new file mode 100644
index 00000000..cd51dc02
--- /dev/null
+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.state/state.base/base.rs
@@ -0,0 +1,98 @@
+//! ALT+TAB switcher state slot: a small sphere overlay drawn INSIDE the current
+//! world (not a world of its own, unlike the full-screen world picker).
+//!
+//! `order` is the CYCLE ORDER for the current mode; `cell_of` is where each of
+//! its entries sits on the sphere, index-parallel to it. TAB rebuilds `order`
+//! only — the ARRANGEMENT is fixed for the session, so a window keeps the same
+//! cell whichever mode is active and the globe never re-lays under the user.
+//! `cell_of` is permuted alongside `order` to preserve exactly that.
+
+use compositor_support_bevy_core_compositor_base::BevyHandle;
+pub use compositor_y5_switcher_state_surface::surface::ListSurface;
+pub use compositor_y5_switcher_state_texture::texture::CellTexture;
+use compositor_support_system_storage_token_base::base::{Token, TokenMut};
+use compositor_y5_switcher_sphere_orient::orient::Orient;
+use smithay::utils::{Physical, Rectangle};
+use uuid::Uuid;
+
+/// How windows are ORDERED. Placement does not depend on this.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Mode {
+    /// Cycle by recency: most-recently-used order.
+    Stack,
+    /// Cycle by position: left to right across the desktop.
+    Spatial,
+}
+
+/// The switcher slot (per-world; on the spawn-target / focused world).
+#[derive(Default)]
+pub struct SwitcherState {
+    pub open: Option<SwitcherOpen>,
+}
+/// One switcher session, from the first ALT+TAB to commit or cancel.
+pub struct SwitcherOpen {
+    /// The MRU snapshot the session opened from, kept so switching back to stack
+    /// mode restores recency order rather than re-deriving it.
+    pub base: Vec<Uuid>,
+    /// The cycle order for `mode`, fixed while that mode is active — an order
+    /// that re-sorted mid-cycle would be unusable. TAB rebuilds it.
+    pub order: Vec<Uuid>,
+    /// Cursor into `order`. This, and only this, is what ALT+TAB steps.
+    pub index: usize,
+    /// Order index -> cell index, parallel to `order`. Total, not optional:
+    /// `order` is capped at `CELL_COUNT`, so every entry gets a cell.
+    pub cell_of: Vec<usize>,
+    pub mode: Mode,
+    /// The outlined cell. Always `cell_of[index]`; stored so the scene can be
+    /// told about it without recomputing.
+    pub selected: Option<usize>,
+    /// The globe's on-screen sub-rect (output-physical).
+    pub rect: Rectangle<i32, Physical>,
+    pub orientation: Orient,
+    pub target: Orient,
+    pub spin: Orient,
+    pub zoom: f32,
+    /// Last known pointer position (output-physical), and the drag anchor while a
+    /// rotation drag is in flight.
+    pub pointer: (f64, f64),
+    pub drag: Option<(f64, f64)>,
+    /// The quick-swap gesture: `Some(n)` while armed, `n` being how many times the
+    /// selection has advanced; `None` once disarmed. Armed at open, disarmed by
+    /// ANYTHING that is not an ALT+TAB — an arrow, a click, a mode toggle, or an
+    /// ALT release that did not commit — and never re-armed for the session. Past
+    /// that first gesture the user is navigating deliberately, and letting go of
+    /// a modifier must not decide for them. Releasing ALT commits only while
+    /// armed with n > 0, so the press that opened the sphere leaves it up.
+    pub quick: Option<usize>,
+    /// Live per-window cell textures, keyed by uuid so rebuilding the order or
+    /// pruning never has to touch them.
+    pub textures: Vec<CellTexture>,
+    /// The stack list's surface + its de-dup and icon caches.
+    pub list: ListSurface,
+    /// The sphere's bevy instance, built lazily by the draw phase (which holds
+    /// the renderer) and torn down on close.
+    pub bevy: Option<BevyHandle<compositor_y5_switcher_three_scene::scene::SwitcherScene>>,
+    /// dt source for the momentum / re-face animation.
+    pub step: std::time::Instant,
+}
+
+impl SwitcherOpen {
+    /// The window the switcher would commit to right now.
+    pub fn current(&self) -> Option<Uuid> {
+        self.order.get(self.index).copied()
+    }
+
+    /// Which entry a cell holds — the inverse of `cell_of`, for when an arrow key
+    /// or a click names a cell rather than an order position.
+    pub fn index_of_cell(&self, cell: usize) -> Option<usize> {
+        self.cell_of.iter().position(|c| *c == cell)
+    }
+}
+
+/// The switcher slot token (read via the core `switcher()` focus accessor).
+pub static SWITCHER: Token<SwitcherState> = Token::new();
+pub static SWITCHER_MUT: TokenMut<SwitcherState> = TokenMut::new(&SWITCHER);
+/// Last-used layout mode, retained across sessions and worlds (kernel store),
+/// as the overview's tab is. The slot itself stays per-world.
+pub static SWITCHER_MODE: Token<Mode> = Token::new();
+pub static SWITCHER_MODE_MUT: TokenMut<Mode> = TokenMut::new(&SWITCHER_MODE);
