@@ -0,0 +1,39 @@
+//! Where the switcher's globe sits on screen, and the mapping a pointer takes to
+//! get into it.
+//!
+//! The globe is a SUB-RECT bevy instance, not a full-screen one. That single
+//! fact is what `sphere.pick::pick_cell` needs honoured: it works in
+//! render-target pixels, so a pointer must be made rect-local before it is
+//! handed over, and the rect's own size passed as the target size.
+
+use compositor_y5_switcher_layout_constant::{SPHERE_FRACTION, SPHERE_MAX_PX, SPHERE_MIN_PX};
+use smithay::utils::{Physical, Point, Rectangle, Size};
+
+/// The globe's square rect, centred on an output of `size`.
+pub fn sphere_rect(size: Size<i32, Physical>) -> Rectangle<i32, Physical> {
+    let short = size.w.min(size.h) as f64;
+    let side = (SPHERE_FRACTION * short).round() as i32;
+    let side = side.clamp(SPHERE_MIN_PX, SPHERE_MAX_PX).min(size.w).min(size.h);
+    let loc = Point::from(((size.w - side) / 2, (size.h - side) / 2));
+    Rectangle::new(loc, Size::from((side, side)))
+}
+
+/// A pointer in output-physical coordinates, expressed relative to `rect`'s
+/// top-left. Deliberately NOT clamped: a pointer outside the rect must stay
+/// outside, so the ray cast misses the sphere and reports "not on the globe"
+/// instead of silently picking an edge cell.
+pub fn to_local(pointer: (f64, f64), rect: Rectangle<i32, Physical>) -> (f64, f64) {
+    (pointer.0 - rect.loc.x as f64, pointer.1 - rect.loc.y as f64)
+}
+
+/// `rect`'s size as the f64 pair `pick_cell` expects as its render target.
+pub fn target_size(rect: Rectangle<i32, Physical>) -> (f64, f64) {
+    (rect.size.w as f64, rect.size.h as f64)
+}
+
+/// Whether an output-physical pointer lies within the globe's rect. A press
+/// outside it is a click-away dismiss rather than a rotation or a selection.
+pub fn contains(pointer: (f64, f64), rect: Rectangle<i32, Physical>) -> bool {
+    let (lx, ly) = to_local(pointer, rect);
+    lx >= 0.0 && ly >= 0.0 && lx < rect.size.w as f64 && ly < rect.size.h as f64
+}
