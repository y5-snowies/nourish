+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.three/three.spawn/spawn.rs
@@ -0,0 +1,92 @@
+//! Startup system: the static camera, the glow backdrop, and the wireframe sphere
+//! of curved cells (occupied cells UV-textured patches, empty cells transparent)
+//! plus the selection outline.
+//!
+//! Ported from `y5.picker/picker.three/three.spawn/spawn.rs`, without the "+"
+//! glyph and with the glow disc added.
+
+use bevy::camera::{Camera, Camera3d, ClearColorConfig, ImageRenderTarget, RenderTarget};
+use bevy::prelude::*;
+use compositor_y5_switcher_sphere_constant::{
+    CAMERA_DISTANCE, CAMERA_FOV_RAD, CELL_COUNT, OCCUPIED_COLOR, OUTLINE_COLOR, WIRE_COLOR,
+};
+use compositor_y5_switcher_sphere_mesh::{line_mesh, patch_mesh, unlit, wire_points};
+use compositor_y5_switcher_three_glow::glow;
+use compositor_y5_switcher_three_state::{
+    SwitcherCamera, SwitcherConfig, SwitcherGlow, SwitcherOutline, SwitcherOutlineMesh,
+    SwitcherRoot,
+};
+
+pub fn spawn(
+    mut commands: Commands,
+    mut meshes: ResMut<Assets<Mesh>>,
+    mut materials: ResMut<Assets<StandardMaterial>>,
+    config: Res<SwitcherConfig>,
+) {
+    commands.spawn((
+        Camera3d::default(),
+        Camera { clear_color: ClearColorConfig::Custom(Color::NONE), ..default() },
+        Projection::Perspective(PerspectiveProjection {
+            fov: CAMERA_FOV_RAD,
+            aspect_ratio: config.output_aspect,
+            near: 0.05,
+            far: 100.0,
+            ..default()
+        }),
+        Transform::from_xyz(0.0, 0.0, CAMERA_DISTANCE).looking_at(Vec3::ZERO, Vec3::Y),
+        RenderTarget::Image(ImageRenderTarget::from(config.output_handle.clone())),
+        SwitcherCamera,
+    ));
+
+    // The backdrop sits OUTSIDE the rotating root, so it stays put while the
+    // globe turns — one that spun with the sphere would read as geometry rather
+    // than as the desktop showing through.
+    commands.spawn((
+        Mesh3d(meshes.add(glow::disc_mesh(glow::cover_radius(CAMERA_DISTANCE), glow::GLOW_COLOR))),
+        MeshMaterial3d(materials.add(glow::disc_material(config.backdrop.clone()))),
+        Transform::from_xyz(0.0, 0.0, glow::GLOW_Z),
+        SwitcherGlow,
+    ));
+
+    // Pre-build assets so the spawn closure borrows nothing mutably.
+    let wire_mesh = meshes.add(line_mesh(wire_points()));
+    let wire_mat = materials.add(unlit(WIRE_COLOR));
+    // One curved patch per OCCUPIED cell: textured with the window's live content
+    // when it has a texture, else a solid fill so the cell still reads as taken.
+    let occupied: Vec<(Handle<Mesh>, Handle<StandardMaterial>)> = (0..CELL_COUNT)
+        .filter_map(|i| {
+            let tex = config.cells.get(i).and_then(|t| t.clone());
+            if tex.is_none() && !config.occupied.get(i).copied().unwrap_or(false) {
+                return None; // empty cell — no patch.
+            }
+            let mat = match tex {
+                Some(tex) => materials.add(StandardMaterial {
+                    base_color_texture: Some(tex), unlit: true, cull_mode: None, ..default()
+                }),
+                None => materials.add(unlit(OCCUPIED_COLOR)),
+            };
+            Some((meshes.add(patch_mesh(i)), mat))
+        })
+        .collect();
+    let outline_handle = meshes.add(line_mesh(Vec::new()));
+    let outline_mat = materials.add(unlit(OUTLINE_COLOR));
+
+    let outline_mesh = outline_handle.clone();
+    commands
+        .spawn((SwitcherRoot, Transform::IDENTITY, Visibility::Visible))
+        .with_children(|root| {
+            root.spawn((Mesh3d(wire_mesh), MeshMaterial3d(wire_mat), Transform::IDENTITY));
+            for (mesh, mat) in occupied {
+                root.spawn((Mesh3d(mesh), MeshMaterial3d(mat), Transform::IDENTITY));
+            }
+            root.spawn((
+                Mesh3d(outline_handle),
+                MeshMaterial3d(outline_mat),
+                Transform::IDENTITY,
+                Visibility::Hidden,
+                SwitcherOutline,
+            ));
+        });
+
+    commands.insert_resource(SwitcherOutlineMesh(outline_mesh));
+}
