+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.texture/texture.render/render.rs
@@ -0,0 +1,80 @@
+//! Rendering each window into its cell texture, once per frame.
+//!
+//! `draw_windows_into` binds the cell's dmabuf as a framebuffer, clears it
+//! transparent and draws the window's surface tree from the client's own
+//! committed buffers. Two consequences worth stating: a window that is occluded
+//! or entirely off-screen still produces content — which no framebuffer-region
+//! capture could ever give — and the compositor's own chrome never leaks in, so
+//! the switcher can never appear inside one of its own cells.
+//!
+//! Only cells on the near hemisphere are refreshed. The far ones are facing away
+//! and their pixels cannot be seen, so rendering them is pure cost — and at 24
+//! cells that halves the per-frame work.
+
+use compositor_orchestration_core_state_base::Loop;
+use compositor_y5_switcher_layout_constant::CELL_TEXTURE_PX;
+use compositor_y5_switcher_sphere_orient::orient::{self, Orient};
+use smithay::backend::renderer::gles::GlesRenderer;
+use smithay::utils::{Physical, Point, Size};
+use uuid::Uuid;
+
+/// Whether `cell` currently faces the camera (which sits on +Z).
+fn facing(cell: usize, orientation: Orient) -> bool {
+    let q = bevy_math_quat(orientation);
+    (q * orient::cell_dir(cell)).z > 0.0
+}
+
+fn bevy_math_quat(o: Orient) -> bevy::math::Quat {
+    bevy::math::Quat::from_array(o.quat())
+}
+
+/// Redraw every visible cell's window into its texture.
+pub fn per_frame(state: &mut Loop, gles: &mut GlesRenderer) {
+    let Some((jobs, orientation)) = plan(state) else { return };
+    let px = CELL_TEXTURE_PX.max(1);
+    let size = Size::<i32, Physical>::from((px, px));
+    for (uuid, cell) in jobs {
+        if !facing(cell, orientation) {
+            continue;
+        }
+        let Some(window) = compositor_y5_switcher_stack_order::order::window_of(state, uuid) else {
+            continue;
+        };
+        // COVER the square target rather than letterboxing into it: scale by the
+        // larger ratio so the window fills the cell edge to edge and the overflow
+        // is clipped, instead of leaving transparent bars around a wide window.
+        // `draw_windows_into` takes one uniform scale, so this crops rather than
+        // distorting — which reads better than a stretched window anyway.
+        let Some(bbox) = state.inner.space_state().state.element_bbox(&window) else { continue };
+        if bbox.size.w < 1 || bbox.size.h < 1 {
+            continue;
+        }
+        let fit = (px as f64 / bbox.size.w as f64).max(px as f64 / bbox.size.h as f64);
+        let loc = Point::from((
+            ((px as f64 - bbox.size.w as f64 * fit) / 2.0).round() as i32,
+            ((px as f64 - bbox.size.h as f64 * fit) / 2.0).round() as i32,
+        ));
+        let Some(open) = state.inner.switcher_mut().open.as_mut() else { return };
+        let Some(tex) = open.textures.iter_mut().find(|t| t.uuid == uuid) else { continue };
+        compositor_y5_graphic_capture_interface::render::draw_windows_into(
+            gles,
+            &mut tex.dmabuf.dmabuf,
+            size,
+            &[(window, loc)],
+            fit,
+        );
+    }
+}
+
+/// The (window, cell) pairs that have a texture, plus the live orientation.
+fn plan(state: &Loop) -> Option<(Vec<(Uuid, usize)>, Orient)> {
+    let open = state.inner.switcher().open.as_ref()?;
+    let jobs = open
+        .order
+        .iter()
+        .enumerate()
+        .filter(|(_, u)| open.textures.iter().any(|t| t.uuid == **u))
+        .filter_map(|(i, u)| open.cell_of.get(i).map(|c| (*u, *c)))
+        .collect();
+    Some((jobs, open.orientation))
+}
diff --git a/compositor.expansion/compositor.y5/y5.switcher/switcher.three/three.apply/apply.rs b/compositor.expansion/compositor.y5/y5.switcher/switcher.three/three.apply/apply.rs
new file mode 100644
index 00000000..c412f0f1
--- /dev/null
+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.three/three.apply/apply.rs
@@ -0,0 +1,88 @@
+//! Per-frame systems: static camera, sphere orientation, selection outline, and
+//! the cell-material refresh that makes live window textures actually appear.
+//!
+//! Ported from `y5.picker/picker.three/three.apply/apply.rs`.
+
+use bevy::prelude::*;
+use compositor_y5_switcher_sphere_constant::camera_distance;
+use compositor_y5_switcher_sphere_mesh::cell_border_points;
+use compositor_y5_switcher_three_state::{
+    SwitcherCamera, SwitcherGlow, SwitcherOutline, SwitcherOutlineMesh, SwitcherRoot,
+    SwitcherSelected, SwitcherTransform,
+};
+
+/// Force each cell material's bind group to rebuild every frame so it picks up
+/// what the compositor rendered into the aliased dmabuf. The deref-mut is
+/// load-bearing: `Assets::get_mut` only emits `AssetEvent::Modified` — which is
+/// what triggers the rebuild — when the returned guard is actually written
+/// through; a bare `get_mut` marks nothing.
+pub fn refresh_cell_materials(
+    cells: Query<&MeshMaterial3d<StandardMaterial>>,
+    mut materials: ResMut<Assets<StandardMaterial>>,
+) {
+    for handle in cells.iter() {
+        if let Some(mut m) = materials.get_mut(&handle.0) {
+            let _ = &mut *m; // deref-mut → Modified → bind-group rebuild
+        }
+    }
+}
+
+/// Static camera on +Z, looking at the origin. Distance comes from the zoom; the
+/// sphere (not the camera) carries all rotation, so screen axes stay world X/Y,
+/// which keeps the trackball and the click ray-cast aligned.
+pub fn idle_camera(
+    transform: Res<SwitcherTransform>,
+    mut cam: Query<&mut Transform, With<SwitcherCamera>>,
+) {
+    let distance = camera_distance(transform.zoom);
+    for mut tf in &mut cam {
+        tf.translation = Vec3::new(0.0, 0.0, distance);
+        tf.look_at(Vec3::ZERO, Vec3::Y);
+    }
+}
+
+/// Keep the backdrop disc covering the render target as the zoom moves the
+/// camera. Without this the blurred copy would slide out of register with the
+/// desktop it was taken from the moment the user scrolled.
+pub fn fit_glow(
+    transform: Res<SwitcherTransform>,
+    mut glow: Query<&mut Transform, With<SwitcherGlow>>,
+) {
+    let scale = compositor_y5_switcher_three_glow::glow::cover_scale(camera_distance(transform.zoom));
+    for mut tf in &mut glow {
+        tf.scale = Vec3::splat(scale);
+    }
+}
+
+/// Apply the sphere's orientation quaternion (compositor-authoritative).
+pub fn apply_rotation(
+    transform: Res<SwitcherTransform>,
+    mut root: Query<&mut Transform, With<SwitcherRoot>>,
+) {
+    let q = Quat::from_array(transform.orientation);
+    for mut tf in &mut root {
+        tf.rotation = q;
+    }
+}
+
+/// Rebuild the outline to the selected cell's curved border on change, and show
+/// or hide it with the selection.
+pub fn apply_selection(
+    selected: Res<SwitcherSelected>,
+    outline_mesh: Option<Res<SwitcherOutlineMesh>>,
+    mut meshes: ResMut<Assets<Mesh>>,
+    mut outline_vis: Query<&mut Visibility, With<SwitcherOutline>>,
+) {
+    if selected.is_changed()
+        && let Some(sel) = selected.0
+        && let Some(outline_mesh) = outline_mesh.as_ref()
+        && let Some(mut mesh) = meshes.get_mut(&outline_mesh.0)
+    {
+        mesh.insert_attribute(Mesh::ATTRIBUTE_POSITION, cell_border_points(sel));
+    }
+
+    let visible = selected.0.is_some();
+    for mut vis in &mut outline_vis {
+        *vis = if visible { Visibility::Visible } else { Visibility::Hidden };
+    }
+}
