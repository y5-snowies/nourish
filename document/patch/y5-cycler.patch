+//! What the GLES phase hands the content band, and how it gets there.
+//!
+//! Split from `draw.frame` so the band side carries no renderer machinery: this
+//! is the only part the renderer-agnostic lowering pass needs to name.
+
+use compositor_orchestration_draw_dispatch_frame::SceneDispatch;
+use compositor_orchestration_draw_node_base::node::{DrawNode, Plan};
+use compositor_support_bevy_core_compositor_base::BevyRenderElement;
+use compositor_support_system_world_frame_base::base as layer;
+use smithay::backend::renderer::{ImportAll, ImportDma, ImportMem, Renderer, Texture};
+
+/// The switcher's contribution to a frame. Empty while it is closed, and empty
+/// on every output but the active one.
+#[derive(Default)]
+pub struct Prepared {
+    pub bevy: Vec<BevyRenderElement>,
+}
+
+/// Add the globe to the content band, on its own layer between the wlr overlay
+/// surfaces and the compositor's screen iced.
+///
+/// Adds nodes rather than owning the band: the desktop behind the switcher keeps
+/// drawing and animating, which is what makes this an overlay INSIDE the current
+/// world rather than a screen that replaces it.
+pub fn push<R>(plan: &mut Plan<R>, prepared: Prepared)
+where
+    R: Renderer + ImportAll + ImportDma + ImportMem + SceneDispatch,
+    R::TextureId: Texture + Clone + Send + 'static,
+{
+    plan.extend(layer::SWITCHER, prepared.bevy.into_iter().map(DrawNode::Background3D));
+}
