+//! Dropping switcher entries whose window has closed.
+//!
+//! Runs first in the frame, before anything else touches the session, so no later
+//! step can resolve a uuid that no longer names a window. A window closing under
+//! an open switcher is ordinary — it is what the app's own quit shortcut does.
+
+use compositor_orchestration_core_state_base::Loop;
+
+/// Remove dead entries, keeping `order` and `cell_of` in step, and close the
+/// switcher outright when nothing survives.
+pub fn prune(state: &mut Loop) {
+    let dead: Vec<usize> = {
+        let Some(open) = state.inner.switcher().open.as_ref() else { return };
+        open.order
+            .iter()
+            .enumerate()
+            .filter(|(_, u)| {
+                compositor_y5_switcher_stack_order::order::window_of(state, **u).is_none()
+            })
+            .map(|(i, _)| i)
+            .collect()
+    };
+    if dead.is_empty() {
+        return;
+    }
+    if let Some(open) = state.inner.switcher_mut().open.as_mut() {
+        // Back to front, so each removal cannot shift an index still to come.
+        for i in dead.into_iter().rev() {
+            open.order.remove(i);
+            open.cell_of.remove(i);
+        }
+        open.index = open.index.min(open.order.len().saturating_sub(1));
+        open.selected = open.cell_of.get(open.index).copied();
+    }
+    if state.inner.switcher().open.as_ref().is_some_and(|o| o.order.is_empty()) {
+        // `close` releases the scene and the list surface too.
+        compositor_y5_switcher_interface_base::base::close(state);
+    }
+}
