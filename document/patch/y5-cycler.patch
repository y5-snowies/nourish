+//! Tearing down the switcher's bevy instance.
+//!
+//! Only the instance: the switcher owns no overlay pane (it draws inside the
+//! current world rather than taking the frame over), so there is no backdrop to
+//! retire — which is the one thing the picker's equivalent has to do and this
+//! deliberately does not.
+
+use compositor_orchestration_core_state_base::Loop;
+use compositor_y5_switcher_system_base::base::scene_registry;
+
+/// Destroy the sphere instance and clear the handle. Safe to call when there is
+/// no session or no instance.
+pub fn destroy(state: &mut Loop) {
+    let id = state
+        .inner
+        .switcher_mut()
+        .open
+        .as_mut()
+        .and_then(|o| o.bevy.take())
+        .map(|h| h.id);
+    let Some(id) = id else { return };
+    if let Some(reg) = scene_registry(&mut state.inner.worlds) {
+        reg.destroy_by_id(id);
+    }
+}
