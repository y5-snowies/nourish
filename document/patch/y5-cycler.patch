index 00000000..40515d03
--- /dev/null
+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.three/three.build/build.rs
@@ -0,0 +1,100 @@
+//! Bodies of `BevyScene::build` / `apply_command` for `SwitcherScene`. Ported
+//! from `y5.picker/picker.three/three.build/build.rs`. Why the bridging works for
+//! LIVE content: the entry installs once, aliasing a dmabuf the compositor
+//! renders each window into, so new pixels appear with no bevy-side work.
+
+use bevy::prelude::*;
+use compositor_support_bevy_core_bridge_base::{BridgeDirection, BridgeEntry, BridgeRegistry};
+use compositor_support_bevy_core_placeholder_base::create_input_placeholder;
+use compositor_y5_switcher_three_state::{
+    SwitcherCommand, SwitcherConfig, SwitcherSelected, SwitcherTransform,
+};
+use std::sync::{Arc, Mutex};
+
+pub fn build(
+    cells: Vec<Option<Arc<wgpu::Texture>>>,
+    backdrop: Option<Arc<wgpu::Texture>>,
+    occupied: Vec<bool>,
+    output_aspect: f32,
+    app: &mut App,
+    output: Handle<Image>,
+) {
+    // Bridge each cell texture into a bevy Image the cell material samples; cells
+    // without one stay None and fall back to a solid patch.
+    let registry = app.world().resource::<BridgeRegistry>().clone();
+    let handles: Vec<Option<Handle<Image>>> = {
+        let mut images = app.world_mut().resource_mut::<Assets<Image>>();
+        cells
+            .into_iter()
+            .map(|tex| {
+                tex.map(|tex| {
+                    let handle =
+                        create_input_placeholder(&mut images, (tex.width(), tex.height()));
+                    registry.push(BridgeEntry {
+                        texture: tex,
+                        handle: handle.clone(),
+                        installed: Arc::new(Mutex::new(false)),
+                        direction: BridgeDirection::Input,
+                        label: "switcher_cell",
+                    });
+                    handle
+                })
+            })
+            .collect()
+    };
+
+    let backdrop = backdrop.map(|tex| {
+        let mut images = app.world_mut().resource_mut::<Assets<Image>>();
+        let handle = create_input_placeholder(&mut images, (tex.width(), tex.height()));
+        drop(images);
+        registry.push(BridgeEntry {
+            texture: tex,
+            handle: handle.clone(),
+            installed: Arc::new(Mutex::new(false)),
+            direction: BridgeDirection::Input,
+            label: "switcher_backdrop",
+        });
+        handle
+    });
+
+    app.insert_resource(SwitcherConfig {
+        output_handle: output,
+        output_aspect,
+        cells: handles,
+        backdrop,
+        occupied,
+    })
+    .insert_resource(SwitcherTransform::default())
+    .insert_resource(SwitcherSelected::default())
+    .add_systems(Startup, compositor_y5_switcher_three_spawn::spawn::spawn)
+    .add_systems(
+        Update,
+        (
+            compositor_y5_switcher_three_apply::idle_camera,
+            compositor_y5_switcher_three_apply::fit_glow,
+            compositor_y5_switcher_three_apply::apply_rotation,
+            compositor_y5_switcher_three_apply::apply_selection,
+            compositor_y5_switcher_three_apply::refresh_cell_materials,
+        ),
+    );
+}
+
+pub fn apply_command(world: &mut World, command: SwitcherCommand) {
+    match command {
+        SwitcherCommand::SetSelected(cell) => {
+            // Guarded: the compositor pushes this every frame, and
+            // `apply_selection` rebuilds the outline whenever the resource is
+            // marked changed. An unconditional write would rebuild for nothing.
+            // Reading through the guard does not mark it; assigning does.
+            let mut selected = world.resource_mut::<SwitcherSelected>();
+            if selected.0 != cell {
+                selected.0 = cell;
+            }
+        }
+        SwitcherCommand::SetTransform { orientation, zoom } => {
+            let mut t = world.resource_mut::<SwitcherTransform>();
+            t.orientation = orientation;
+            t.zoom = zoom;
+        }
+    }
+}
