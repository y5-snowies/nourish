new file mode 100644
index 00000000..dc05d024
--- /dev/null
+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.system/system.base/base.rs
@@ -0,0 +1,48 @@
+//! `SwitcherSystem` — seeds the ALT+TAB switcher slot on its world — and the
+//! resolver for the bevy registry its sphere is built in.
+//!
+//! Rim-driven (opened from the keyboard, stepped from the draw phase) rather than
+//! mutated through the input bus, so this system owns no buffer or channel — it
+//! only inserts the default slot at world build time. Register it on every
+//! SPATIAL world: the switcher cycles that world's own windows, and
+//! `Loop::switcher()` reads the slot every frame.
+
+use compositor_support_bevy_core_compositor_base::BevyRegistry;
+use compositor_support_system_trait_system_base::base::{System, WorldBuilder};
+use compositor_support_system_world_identity_base::base::PICKER_WORLD;
+use compositor_y5_switcher_state_base::base::{SwitcherState, SWITCHER};
+
+/// The bevy registry the switcher's sphere instance lives in.
+///
+/// Deliberately NOT the focused world's: `create_world_with_id` omits
+/// `ThreeSystem`, so a world made at runtime has no registry at all, and the
+/// switcher must work in every spatial world. `PICKER_WORLD` always has one and
+/// is never itself a spatial world, which makes it the neutral host — the same
+/// place the overview's embedded globe builds into while another world is active.
+///
+/// This names a fixed world id, but it is not the thing the WORLD-ID rule bans:
+/// it answers "where does the registry live", never "which world is focused".
+/// Takes `WorldManager` rather than `Loop` so this crate stays free of a cycle
+/// with `orchestration.core.state`, exactly as `picker.system::registry` does.
+pub fn scene_registry(
+    worlds: &mut compositor_orchestration_world_manager_base::manager::WorldManager,
+) -> Option<&mut BevyRegistry> {
+    worlds
+        .get_mut(PICKER_WORLD)
+        .storage_mut()
+        .try_get_mut(&compositor_background_three_system_base::base::BG_THREE_MUT)
+        .and_then(|b| b.registry.as_mut())
+}
+
+#[derive(Default)]
+pub struct SwitcherSystem;
+
+impl System for SwitcherSystem {
+    fn name(&self) -> &'static str {
+        "switcher"
+    }
+
+    fn register(&mut self, builder: &mut WorldBuilder) {
+        builder.storage.insert(&SWITCHER, SwitcherState::default());
+    }
+}
