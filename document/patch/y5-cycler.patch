@@ -0,0 +1,55 @@
+//! `SwitcherScene`: the ALT+TAB sphere of window cells, and its `BevyScene` impl.
+//! Sibling crates hold the geometry, spawn, per-frame systems and command body;
+//! this crate is the facade the compositor instantiates.
+
+use bevy::asset::Handle;
+use bevy::image::Image;
+use bevy::prelude::{App, World};
+use std::sync::Arc;
+
+pub use compositor_y5_switcher_three_state::SwitcherCommand;
+
+pub struct SwitcherScene {
+    pub output_aspect: f32,
+    /// Per-cell live window texture (None → solid or empty). Index is the cell.
+    pub cells: Vec<Option<Arc<wgpu::Texture>>>,
+    /// The blurred desktop behind the globe, if one could be made.
+    pub backdrop: Option<Arc<wgpu::Texture>>,
+    /// Per-cell occupancy. A cell may be occupied with no texture — allocation
+    /// can fail, and a solid patch is a better answer than a hole.
+    pub occupied: Vec<bool>,
+}
+
+impl SwitcherScene {
+    /// `target_size` is the OVERLAY's sub-rect, not the output: the switcher's
+    /// globe is a small centred instance, and the aspect must describe the
+    /// surface it is actually rendered into or the ray-cast disagrees with it.
+    pub fn new(
+        target_size: (u32, u32),
+        cells: Vec<Option<Arc<wgpu::Texture>>>,
+        backdrop: Option<Arc<wgpu::Texture>>,
+        occupied: Vec<bool>,
+    ) -> Self {
+        let output_aspect = target_size.0 as f32 / target_size.1.max(1) as f32;
+        Self { output_aspect, cells, backdrop, occupied }
+    }
+}
+
+impl compositor_support_bevy_core_scene_base::BevyScene for SwitcherScene {
+    type Command = SwitcherCommand;
+
+    fn build(&self, app: &mut App, output: Handle<Image>) {
+        compositor_y5_switcher_three_build::build::build(
+            self.cells.clone(),
+            self.backdrop.clone(),
+            self.occupied.clone(),
+            self.output_aspect,
+            app,
+            output,
+        )
+    }
+
+    fn apply_command(&self, world: &mut World, command: Self::Command) {
+        compositor_y5_switcher_three_build::build::apply_command(world, command)
+    }
+}
