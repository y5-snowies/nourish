diff --git a/compositor.expansion/compositor.y5/y5.switcher/switcher.texture/texture.alloc/alloc.rs b/compositor.expansion/compositor.y5/y5.switcher/switcher.texture/texture.alloc/alloc.rs
new file mode 100644
index 00000000..d760789c
--- /dev/null
+++ b/compositor.expansion/compositor.y5/y5.switcher/switcher.texture/texture.alloc/alloc.rs
@@ -0,0 +1,90 @@
+//! Allocating one live cell texture per window in the switcher's order.
+//!
+//! The recipe is the capture registry's `alloc_entry` — negotiate modifiers both
+//! APIs accept, allocate a dmabuf, import it to wgpu — but deliberately NOT
+//! routed through `CaptureRegistry` itself. That registry blits the composed
+//! output framebuffer into every entry for the output on each tick, which would
+//! stamp screen pixels over per-window cells; and it de-duplicates entries on
+//! `(source, size)` with no window identity, so two same-sized windows would
+//! silently share one buffer. Owning the dmabufs directly avoids both.
+//!
+//! The GLES import the registry also keeps is skipped: nothing here samples the
+//! buffer through GLES — `draw_windows_into` binds the dmabuf as a framebuffer
+//! and does its own import.
+
+use compositor_orchestration_core_state_base::Loop;
+use compositor_support_bevy_core_alloc_base::allocate_dmabuf_negotiated;
+use compositor_support_bevy_core_import_base::import_dmabuf_to_wgpu;
+use compositor_y5_switcher_layout_constant::CELL_TEXTURE_PX;
+use compositor_y5_switcher_state_base::base::CellTexture;
+use smithay::backend::allocator::Fourcc;
+use smithay::backend::renderer::ImportDma;
+use smithay::backend::renderer::gles::GlesRenderer;
+use std::sync::Arc;
+use uuid::Uuid;
+
+/// Allocate one square target for `uuid` at `px`, or `None` if the GPU cannot.
+/// Public because the backdrop wants the same recipe at a much smaller size.
+pub fn allocate_sized(
+    state: &Loop,
+    gles: &mut GlesRenderer,
+    uuid: Uuid,
+    px: u32,
+) -> Option<CellTexture> {
+    let ctx = state
+        .inner
+        .kernel
+        .try_get(&compositor_background_three_system_base::base::BEVY_CONTEXT)
+        .and_then(|c| c.clone())?;
+    let fourcc = Fourcc::Argb8888;
+    let mods = compositor_kernel_graphic_bridge_negotiate_base::negotiate::bridge_modifiers(
+        ImportDma::dmabuf_formats(gles),
+        ctx.importable.clone(),
+        fourcc,
+    );
+    let node = state.inner.environment.GPU.clone();
+    let dmabuf = match allocate_dmabuf_negotiated(&node, px, px, fourcc, &mods) {
+        Ok(d) => d,
+        Err(e) => {
+            warn!("switcher: cell dmabuf alloc failed for {uuid}: {e:?}");
+            return None;
+        }
+    };
+    match import_dmabuf_to_wgpu(&ctx, &dmabuf.dmabuf) {
+        Ok(tex) => Some(CellTexture { uuid, dmabuf, wgpu: Arc::new(tex) }),
+        Err(e) => {
+            warn!("switcher: cell wgpu import failed for {uuid}: {e:?}");
+            None
+        }
+    }
+}
+
+/// Reconcile the texture set against the current order: drop textures for
+/// windows no longer in it, allocate for those missing one. A window whose
+/// allocation fails simply has none, and its cell renders as a solid patch.
+pub fn ensure(state: &mut Loop, gles: &mut GlesRenderer) {
+    let Some(order) = state.inner.switcher().open.as_ref().map(|o| o.order.clone()) else {
+        return;
+    };
+    if let Some(open) = state.inner.switcher_mut().open.as_mut() {
+        // The backdrop shares this list but belongs to no window, so it is not
+        // reconciled against the order — only cleared with the session.
+        open.textures.retain(|t| t.uuid.is_nil() || order.contains(&t.uuid));
+    }
+    for uuid in order {
+        let have = state
+            .inner
+            .switcher()
+            .open
+            .as_ref()
+            .is_some_and(|o| o.textures.iter().any(|t| t.uuid == uuid));
+        if have {
+            continue;
+        }
+        let px = CELL_TEXTURE_PX.max(1) as u32;
+        let Some(tex) = allocate_sized(state, gles, uuid, px) else { continue };
+        if let Some(open) = state.inner.switcher_mut().open.as_mut() {
+            open.textures.push(tex);
+        }
+    }
+}
