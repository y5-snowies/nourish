@@ -0,0 +1,35 @@
+//! What KIND of thing a `smithay::desktop::Window` is.
+//!
+//! Two questions the compositor asks a window before deciding how to treat it,
+//! and both have an xdg answer and an X11 answer. They live apart from
+//! `window.shell` (which SPEAKS to a window) because these are read on paths
+//! that never configure anything — the navigation targets, the overview grid,
+//! the rubber-band selection, the decoration border.
+
+use smithay::desktop::Window;
+
+/// Is this a window the user owns, rather than transient chrome?
+///
+/// Everything mapped into the Space is a `Window`, but an X11 override-redirect
+/// surface — a menu, a tooltip, a drag icon — is chrome its own client places
+/// and removes. It must never be framed, tiled, selected, grouped or given a
+/// placeholder, so the navigation and layout paths filter on this.
+///
+/// There is no wayland equivalent: an xdg popup is not a `Window` at all (it is
+/// tracked by the `PopupManager` and drawn as part of its parent), which is why
+/// the filters this replaces could get away with `toplevel().is_some()`.
+pub fn is_window(window: &Window) -> bool {
+    !window.x11_surface().is_some_and(|x11| x11.is_override_redirect())
+}
+
+/// Does this window declare itself subordinate to another one — an xdg
+/// `parent`, or an X11 `WM_TRANSIENT_FOR`?
+///
+/// Such windows size themselves, so the initial-map path leaves their expected
+/// size `Auto` instead of locking it to whatever they first mapped at.
+pub fn has_parent(window: &Window) -> bool {
+    if let Some(toplevel) = window.toplevel() {
+        return toplevel.parent().is_some();
+    }
+    window.x11_surface().is_some_and(|x11| x11.is_transient_for().is_some())
+}
