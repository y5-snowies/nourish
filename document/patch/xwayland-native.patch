+++ b/compositor.support/support.smithay/smithay.state/state.xwayland/xwayland.base/base.rs
@@ -0,0 +1,64 @@
+//! The XWayland half of the protocol state, held by `Dispatch`.
+//!
+//! Two connections make XWayland work (see smithay's `xwayland` module): the
+//! Xwayland process is an ordinary WAYLAND client of ours whose surfaces arrive
+//! through the normal compositor path, and separately we act as its X11 WINDOW
+//! MANAGER over a private socket. `shell` is the wayland half — the
+//! `xwayland_shell_v1` global Xwayland binds to tell us which wl_surface backs
+//! which X11 window — and `xwm` is the window-manager half.
+//!
+//! The outboxes below exist for the same reason as the ones on `Dispatch`
+//! itself (document/SMITHAY_DECOUPLING.md): `XwmHandler` runs inside the X11
+//! event source with no access to the world, so it records what happened and
+//! `Wire::drain_protocol` applies it against the Space. Managed windows do NOT
+//! get an outbox of their own — they are pushed onto `Dispatch::new_toplevels`
+//! beside xdg toplevels, so one drain arm maps both kinds and an X11 window
+//! picks up the same uuid, placeholder and draw-order treatment as any other.
+
+use std::collections::HashMap;
+
+use smithay::desktop::Window;
+use smithay::reexports::wayland_server::protocol::wl_surface::WlSurface;
+use smithay::utils::{Logical, Rectangle};
+use smithay::wayland::xwayland_shell::XWaylandShellState;
+use smithay::xwayland::{X11Surface, X11Wm};
+
+pub struct Xwayland {
+    pub shell: XWaylandShellState,
+    /// `None` until the Xwayland server signals ready and the loader starts the
+    /// window manager — every X11 path has to tolerate that window.
+    pub xwm: Option<X11Wm>,
+    /// The X display number (`:1`) children are told about through `DISPLAY`.
+    pub display: Option<u32>,
+    /// Override-redirect surfaces that just mapped: menus, tooltips, drag
+    /// icons. They are placed at the coordinates the X client chose and given
+    /// none of the y5 window identity — no uuid, no placeholder, no tile.
+    pub mapped_override: Vec<Window>,
+    /// Surfaces that unmapped or were destroyed. Both land here: an X11 unmap
+    /// is how a client withdraws a window, and the destroy that may follow is
+    /// not guaranteed to arrive at all.
+    pub gone: Vec<X11Surface>,
+    /// `ConfigureNotify` positions for already-mapped surfaces — an
+    /// override-redirect menu repositioning itself, which nothing else tracks.
+    pub moved: Vec<(X11Surface, Rectangle<i32, Logical>)>,
+    /// (un)fullscreen requests, applied against the world at drain.
+    pub fullscreen: Vec<(X11Surface, bool)>,
+    /// The X11 stacking order last published to the server, as window ids
+    /// topmost-first. The sync that maintains it grabs the X server, and the
+    /// drain it runs from fires on every wayland dispatch — so it has to be able
+    /// to answer "nothing moved" without a round trip, which is what this is.
+    pub stacking: Vec<u32>,
+    /// wl_surface → X11 surface, maintained from the association callback.
+    ///
+    /// y5's seat keyboard focus is a plain `WlSurface`
+    /// (`SeatHandler::KeyboardFocus`), so smithay's `KeyboardTarget for
+    /// X11Surface` — where a compositor with an enum focus target gets the X11
+    /// half of focus for free — is never reached. `focus_changed` has to drive
+    /// `X11Surface::set_input_focus` itself, and this is how it gets from the
+    /// surface it is handed to the X11 window behind it.
+    pub focus_index: HashMap<WlSurface, X11Surface>,
+    /// True while an X11 client owns the clipboard. The wayland selection then
+    /// names X11 as its source, and a paste has to be routed back over the X
+    /// connection instead of served from the persistence capture.
+    pub x11_selection: bool,
+}
