--- /dev/null
+++ b/compositor.support/support.smithay/smithay.state/state.window/window.shell/shell.rs
@@ -0,0 +1,110 @@
+//! Shell-agnostic window operations.
+//!
+//! A `smithay::desktop::Window` is either an xdg toplevel or an X11 (XWayland)
+//! surface, and the two answer the same question through different protocols:
+//! an xdg toplevel carries a DOUBLE-BUFFERED pending state that a later
+//! `send_configure` commits, while an X11 window is configured by one immediate
+//! call carrying position AND size together. Everything above the wire layer
+//! only ever wants "tell this window to be this big", so the split lives here
+//! and nowhere else — a `window.toplevel().unwrap()` anywhere above this layer
+//! is an abort waiting for the first X11 client.
+//!
+//! `position` is the window's location in the world Space. Only the X11 half
+//! reads it, and it matters: an X client places its own override-redirect
+//! children (menus, tooltips) against the coordinates we handed their parent, so
+//! those must be the y5-world ones the Space stores — configure at the origin and
+//! every menu the window opens lands that far away.
+//!
+//! Note `last_configure` vs `geometry` throughout: smithay subtracts
+//! `_GTK_FRAME_EXTENTS` from an X11 window's `geometry`, so that is the VISIBLE
+//! rect while `configure` speaks the full X rect including shadow.
+
+use smithay::desktop::Window;
+use smithay::reexports::wayland_protocols::xdg::shell::server::xdg_toplevel;
+use smithay::utils::{Logical, Point, Rectangle, Size};
+
+/// Stage a compositor-decided size without emitting anything.
+///
+/// xdg: written into the pending state, emitted by the next [`send`]. X11:
+/// dropped — there is no pending state, and the size only reaches an X client
+/// together with its position, which [`send`] supplies.
+pub fn stage(window: &Window, size: Size<i32, Logical>, resizing: bool) {
+    let Some(toplevel) = window.toplevel() else { return };
+    toplevel.with_pending_state(|state| {
+        if resizing {
+            state.states.set(xdg_toplevel::State::Resizing);
+        }
+        state.size = Some(size);
+    });
+}
+
+/// Emit the configuration: the size staged above for xdg, `position + size` in
+/// one `ConfigureNotify` for X11.
+pub fn send(window: &Window, position: Point<i32, Logical>, size: Size<i32, Logical>) {
+    if let Some(x11) = window.x11_surface() {
+        if let Err(err) = x11.configure(Rectangle::new(position, size)) {
+            warn!("x11 configure failed: {err:?}");
+        }
+        return;
+    }
+    if let Some(toplevel) = window.toplevel() {
+        toplevel.send_configure();
+    }
+}
+
+/// Emit a configure only if something changed (activation, suspend, decoration
+/// mode). X11 writes those as properties, so this is an xdg-only concern.
+pub fn send_pending(window: &Window) {
+    if let Some(toplevel) = window.toplevel() {
+        toplevel.send_pending_configure();
+    }
+}
+
+/// Ask the client to dismiss just this window — the title-bar X, not the
+/// process.
+///
+/// `false` means nothing was asked and the caller must escalate (kill the pid);
+/// it does NOT mean "no close protocol". An X11 window that does not list
+/// `WM_DELETE_WINDOW` is destroyed outright instead — what every X window
+/// manager does for the title-bar X — so the close still happened.
+pub fn close(window: &Window) -> bool {
+    if let Some(toplevel) = window.toplevel() {
+        toplevel.send_close();
+        return true;
+    }
+    let Some(x11) = window.x11_surface() else { return false };
+    match x11.close() {
+        Ok(()) => true,
+        Err(err) => {
+            warn!("x11 close failed: {err:?}");
+            false
+        }
+    }
+}
+
+/// Tell an X11 window where it now IS, after the compositor moved it.
+///
+/// No-op for xdg, by design and not by omission: a wayland client is never told
+/// its position and does not need to be — its popups are placed by the
+/// compositor from a positioner. An X client places its own override-redirect
+/// children (menus, tooltips) from its own coordinates, so a window dragged
+/// across the canvas without this opens its menus back where it used to be.
+///
+/// Keeps whatever size the window currently has: this is the MOVE half, and the
+/// resize half goes through [`stage`] + [`send`].
+pub fn moved(window: &Window, position: Point<i32, Logical>) {
+    let Some(x11) = window.x11_surface() else { return };
+    let size = x11.last_configure().size;
+    if let Err(err) = x11.configure(Rectangle::new(position, size)) {
+        warn!("x11 move configure failed: {err:?}");
+    }
+}
+
+/// The size to treat as this window's compositor-decided slot at map time.
+/// X11 reports the size it was last CONFIGURED at (see the note above).
+pub fn configured_size(window: &Window) -> Size<i32, Logical> {
+    match window.x11_surface() {
+        Some(x11) => x11.last_configure().size,
+        None => window.geometry().size,
+    }
+}
